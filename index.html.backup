<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DARK AI</title>
<script src="https://js.puter.com/v2/"></script>
<style>
  :root {
    --bg: #f5f7ff; --bg-2: #ffffff; --bg-3: #eef2ff;
    --surface: rgba(255,255,255,0.72);
    --fg: #131a3a; --muted: #6b7499;
    --accent: #4f46e5; --accent-2: #06b6d4; --accent-3: #a855f7;
    --ok: #10b981; --err: #e11d48; --rec: #ef4444;
    --warn: #f59e0b; --gold: #fbbf24;
    --border: rgba(79,70,229,0.10); --border-2: rgba(79,70,229,0.22);
    --glow: 0 0 32px rgba(79,70,229,0.25);
    --shadow: 0 8px 32px rgba(79,70,229,0.08);
    --code-bg: #f1f5ff; --code-fg: #1e40af;
  }
  [data-theme="dark"] {
    --bg: #050810; --bg-2: #0c1322; --bg-3: #131b30;
    --surface: rgba(19,27,48,0.7);
    --fg: #eaf0ff; --muted: #8b94b8;
    --accent: #6366f1; --accent-2: #22d3ee; --accent-3: #c084fc;
    --border: rgba(99,102,241,0.15); --border-2: rgba(99,102,241,0.30);
    --glow: 0 0 32px rgba(99,102,241,0.40);
    --shadow: 0 8px 32px rgba(0,0,0,0.4);
    --code-bg: #0a1020; --code-fg: #93c5fd;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: var(--bg); color: var(--fg);
    font-family: 'Inter', 'Noto Sans Ethiopic', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height: 1.6; -webkit-font-smoothing: antialiased;
    display: flex; flex-direction: column;
    transition: background .4s, color .4s; overflow: hidden;
  }
  .bg-layer { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.45; animation: blobFloat 22s ease-in-out infinite; }
  .blob-1 { width: 340px; height: 340px; background: var(--accent); top: -100px; left: -100px; }
  .blob-2 { width: 300px; height: 300px; background: var(--accent-2); top: 35%; right: -120px; animation-delay: -7s; }
  .blob-3 { width: 260px; height: 260px; background: var(--accent-3); bottom: -80px; left: 30%; animation-delay: -14s; }
  @keyframes blobFloat {
    0%,100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(50px,-40px) scale(1.15); }
    66% { transform: translate(-40px,50px) scale(0.9); }
  }
  header {
    background: var(--surface);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .nav {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.75rem 1.25rem;
  }
  .nav-left { display: flex; align-items: center; gap: 0.6rem; }
  .brand {
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 1.15rem; font-weight: 900; letter-spacing: 5px;
    color: var(--fg); text-decoration: none;
  }
  .brand-mark {
    width: 36px; height: 36px; border-radius: 11px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem; color: white; box-shadow: var(--glow);
    animation: brandPulse 3s ease-in-out infinite;
  }
  @keyframes brandPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  .nav-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .auth-badge {
    display: flex; align-items: center; gap: 0.4rem;
    background: var(--bg-3); border: 1px solid var(--border-2);
    color: var(--accent); padding: 0.4rem 0.8rem;
    border-radius: 11px; font-size: 0.75rem; font-weight: 700;
    height: 38px; white-space: nowrap;
    max-width: 180px; overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    transition: all .2s;
  }
  .auth-badge:hover { border-color: var(--accent); box-shadow: var(--glow); }
  .auth-badge .avatar-sm {
    width: 20px; height: 20px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 0.65rem; font-weight: 800;
    flex-shrink: 0;
  }
  .auth-badge.admin {
    background: linear-gradient(135deg, var(--gold), #f59e0b);
    color: white; border-color: transparent;
  }
  .icon-tool {
    width: 40px; height: 40px; border-radius: 12px;
    background: transparent; border: 1px solid var(--border-2);
    color: var(--accent); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all .3s; position: relative; overflow: hidden;
    -webkit-tap-highlight-color: transparent; flex-shrink: 0;
  }
  .icon-tool svg {
    width: 18px; height: 18px; transition: transform .35s;
    stroke-width: 2; stroke: currentColor; fill: none;
    stroke-linecap: round; stroke-linejoin: round;
    position: relative; z-index: 1;
  }
  .icon-tool::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    opacity: 0; transition: opacity .3s; border-radius: inherit;
  }
  .icon-tool:hover {
    border-color: var(--accent); box-shadow: var(--glow);
    transform: translateY(-2px); color: white;
  }
  .icon-tool:hover::before { opacity: 1; }
  .icon-tool:hover svg { transform: scale(1.15) rotate(-8deg); }
  .icon-tool:disabled { opacity: 0.4; cursor: not-allowed; }
  .icon-tool.danger { color: var(--err); border-color: rgba(225,29,72,0.3); }
  .icon-tool.danger::before { background: linear-gradient(135deg, var(--err), #f43f5e); }
  .icon-tool.danger:hover { border-color: var(--err); box-shadow: 0 0 24px rgba(225,29,72,0.5); }
  .icon-tool.danger:hover svg { transform: scale(1.15) rotate(12deg); }
  .icon-tool.save.pulse { animation: savePulse 0.6s ease; }
  @keyframes savePulse {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.15); box-shadow: 0 0 30px rgba(16,185,129,0.8); color: var(--ok); border-color: var(--ok); }
  }
  .icon-tool.save.done { color: var(--ok); border-color: var(--ok); }
  .icon-tool.save.done::before { background: linear-gradient(135deg, var(--ok), #34d399); opacity: 1; }
  .icon-tool.save.done svg { color: white; }
  .layout {
    flex: 1; max-width: 1200px; width: 100%;
    margin: 0 auto; display: flex; gap: 1rem;
    padding: 1rem 1.25rem; overflow: hidden; min-height: 0;
  }
  .sidebar {
    width: 260px; flex-shrink: 0;
    background: var(--surface);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--border-2); border-radius: 20px;
    padding: 1rem; display: flex; flex-direction: column;
    gap: 0.75rem; overflow: hidden;
    transition: width .3s ease, padding .3s ease, opacity .3s;
  }
  .sidebar.hidden { width: 0; padding: 1rem 0; opacity: 0; border-width: 0; pointer-events: none; }
  .sidebar > * { min-width: 220px; }
  .user-card {
    background: var(--bg-3); border: 1px solid var(--border-2);
    border-radius: 12px; padding: 0.75rem;
    display: flex; align-items: center; gap: 0.6rem;
    flex-shrink: 0; cursor: pointer; transition: all .25s;
  }
  .user-card:hover { border-color: var(--accent); box-shadow: var(--glow); }
  .user-card .avatar-lg {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 800; font-size: 0.95rem;
    flex-shrink: 0;
  }
  .user-card .info { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; flex: 1; }
  .user-card .name { font-size: 0.82rem; font-weight: 700; color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .user-card .sub { font-size: 0.68rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .user-card .crown { font-size: 1rem; color: var(--gold); filter: drop-shadow(0 0 6px rgba(251,191,36,0.7)); }
  .new-chat {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; border: none; padding: 0.75rem 1rem;
    border-radius: 12px; font-weight: 700; font-size: 0.88rem;
    cursor: pointer; font-family: inherit;
    display: flex; align-items: center; justify-content: center;
    gap: 0.4rem; transition: all .25s;
    box-shadow: 0 4px 12px rgba(79,70,229,0.25);
    flex-shrink: 0; -webkit-tap-highlight-color: transparent;
  }
  .new-chat:hover { transform: translateY(-2px); box-shadow: var(--glow); }
  .search-box {
    background: var(--bg-3); border: 1px solid var(--border-2);
    border-radius: 10px; padding: 0.55rem 0.85rem;
    color: var(--fg); font-family: inherit; font-size: 0.85rem;
    outline: none; flex-shrink: 0;
  }
  .search-box:focus { border-color: var(--accent); }
  .chat-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 0.35rem; min-height: 0; }
  .chat-item {
    padding: 0.65rem 0.8rem; border-radius: 10px;
    cursor: pointer; border: 1px solid transparent;
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.5rem; transition: all .2s; font-size: 0.85rem; flex-shrink: 0;
  }
  .chat-item:hover { background: var(--bg-3); border-color: var(--border-2); }
  .chat-item.active { background: var(--bg-3); border-color: var(--accent); color: var(--accent); }
  .chat-item span { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-item .del {
    opacity: 0; background: transparent; border: none;
    color: var(--err); cursor: pointer; font-size: 0.9rem;
    padding: 0.2rem 0.35rem; border-radius: 6px; transition: all .2s;
  }
  .chat-item:hover .del { opacity: 1; }
  .sidebar-footer {
    border-top: 1px solid var(--border); padding-top: 0.75rem;
    display: flex; flex-direction: column; gap: 0.4rem; flex-shrink: 0;
  }
  .sidebar-btn {
    background: transparent; border: 1px solid var(--border-2);
    color: var(--fg); padding: 0.55rem; border-radius: 10px;
    font-size: 0.8rem; cursor: pointer; font-family: inherit;
    display: flex; align-items: center; gap: 0.5rem;
    transition: all .2s; font-weight: 500;
    -webkit-tap-highlight-color: transparent;
  }
  .sidebar-btn:hover { background: var(--bg-3); border-color: var(--accent); color: var(--accent); }
  .sidebar-btn.admin {
    background: linear-gradient(135deg, var(--gold), #f59e0b);
    color: white; border-color: transparent;
  }
  .sidebar-btn.admin:hover { transform: translateY(-2px); box-shadow: 0 0 24px rgba(251,191,36,0.5); }
  .chat-area { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
  .chat-wrap {
    flex: 1; background: var(--surface);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--border-2); border-radius: 24px;
    overflow: hidden; box-shadow: var(--shadow), var(--glow);
    display: flex; flex-direction: column;
    min-height: 0; position: relative;
  }
  .chat-wrap::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-3));
    background-size: 200% auto;
    animation: topShine 3s linear infinite; z-index: 2;
  }
  @keyframes topShine { to { background-position: 200% center; } }
  .chat-head {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.9rem 1.2rem;
    background: linear-gradient(90deg, rgba(79,70,229,0.06), transparent);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap; flex-shrink: 0;
  }
  .status-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--ok); box-shadow: 0 0 10px var(--ok);
    animation: pulse 2s ease-in-out infinite; flex-shrink: 0;
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .chat-head-title { display: flex; flex-direction: column; flex: 1; min-width: 100px; }
  .chat-head-title b {
    font-size: 0.92rem; font-weight: 800; letter-spacing: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .chat-head-title small { font-size: 0.7rem; color: var(--muted); }
  .chat-tools { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
  .chat-body {
    flex: 1; overflow-y: auto; padding: 1.4rem 1.2rem;
    display: flex; flex-direction: column; gap: 0.9rem;
    scroll-behavior: smooth; min-height: 0;
  }
  .welcome { text-align: center; padding: 2rem 1rem 1rem; }
  .welcome-icon {
    width: 68px; height: 68px; margin: 0 auto 1.15rem;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; box-shadow: var(--glow);
    animation: floatY 3s ease-in-out infinite;
  }
  @keyframes floatY {
    0%,100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(3deg); }
  }
  .welcome h1 {
    font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    font-weight: 900; letter-spacing: -0.02em;
    margin-bottom: 0.6rem; line-height: 1.15;
  }
  .welcome h1 .grad {
    background: linear-gradient(120deg, var(--accent), var(--accent-2), var(--accent-3), var(--accent));
    background-size: 300% auto;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; display: inline-block;
  }
  .welcome p { color: var(--muted); max-width: 480px; margin: 0 auto; font-size: 0.92rem; line-height: 1.65; }
  .quick-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.55rem; max-width: 620px; margin: 1.5rem auto 0; padding: 0 0.5rem;
  }
  .quick-card {
    background: var(--bg-2); border: 1px solid var(--border-2);
    border-radius: 12px; padding: 0.75rem 0.9rem;
    cursor: pointer; text-align: left; font-family: inherit; color: var(--fg);
    transition: all .25s; display: flex; align-items: center; gap: 0.6rem;
    -webkit-tap-highlight-color: transparent;
  }
  .quick-card:hover {
    border-color: var(--accent); background: var(--bg-3);
    transform: translateY(-2px); box-shadow: var(--glow);
  }
  .quick-card .qc-emoji { font-size: 1.15rem; flex-shrink: 0; }
  .quick-card .qc-text { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; }
  .quick-card .qc-title { font-size: 0.82rem; font-weight: 700; color: var(--fg); }
  .quick-card .qc-desc { font-size: 0.7rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msg-row { display: flex; gap: 0.5rem; align-items: flex-end; animation: slideIn .35s; }
  .msg-row.user { justify-content: flex-end; }
  .msg-row.ai { justify-content: flex-start; }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .msg-col { display: flex; flex-direction: column; max-width: 82%; }
  .msg {
    padding: 0.8rem 1.1rem; border-radius: 18px;
    font-size: 0.9rem; line-height: 1.65;
    word-wrap: break-word; overflow-wrap: break-word;
  }
  .msg.user {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; border-bottom-right-radius: 4px;
    font-weight: 500; box-shadow: 0 8px 24px rgba(79,70,229,0.28);
    white-space: pre-wrap;
  }
  .msg.ai {
    background: var(--bg-2); border: 1px solid var(--border-2);
    color: var(--fg); border-bottom-left-radius: 4px;
  }
  [data-theme="dark"] .msg.ai { background: rgba(99,102,241,0.06); }
  .msg.ai h1, .msg.ai h2, .msg.ai h3 { margin: 0.7rem 0 0.4rem; font-weight: 800; line-height: 1.3; }
  .msg.ai h1 { font-size: 1.12rem; }
  .msg.ai h2 { font-size: 1.02rem; }
  .msg.ai h3 { font-size: 0.96rem; }
  .msg.ai p { margin: 0.35rem 0; }
  .msg.ai ul, .msg.ai ol { margin: 0.35rem 0; padding-inline-start: 1.3rem; }
  .msg.ai li { margin: 0.15rem 0; }
  .msg.ai a { color: var(--accent); text-decoration: underline; }
  .msg.ai code.inline {
    background: var(--code-bg); color: var(--code-fg);
    padding: 0.15rem 0.4rem; border-radius: 5px;
    font-family: 'JetBrains Mono', monospace; font-size: 0.85em;
  }
  /* Prompt Box */
.prompt-box {
  margin-top: 1rem;
  background: var(--bg-3);
  border: 1px solid var(--border-2);
  border-radius: 14px;
  padding: 1rem;
}
.prompt-text {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--fg);
  background: var(--bg-2);
  padding: 0.75rem;
  border-radius: 10px;
  border: 1px solid var(--border);
  margin-bottom: 0.75rem;
  max-height: 150px;
  overflow-y: auto;
  font-family: 'JetBrains Mono', monospace;
  white-space: pre-wrap;
  word-break: break-word;
}
.prompt-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.prompt-btn {
  flex: 1;
  min-width: 120px;
  background: transparent;
  border: 1px solid var(--border-2);
  color: var(--accent);
  padding: 0.7rem 1rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.82rem;
  cursor: pointer;
  font-family: inherit;
  transition: all .25s;
  letter-spacing: 0.5px;
}
.prompt-btn:hover {
  border-color: var(--accent);
  background: rgba(79,70,229,0.08);
  transform: translateY(-1px);
}
.prompt-btn.primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white;
  border-color: transparent;
}
.prompt-btn.primary:hover {
  box-shadow: var(--glow);
  transform: translateY(-2px);
}
.prompt-btn.done {
  background: rgba(16,185,129,0.15);
  color: var(--ok);
  border-color: var(--ok);
}
.msg.ai pre {
    background: var(--code-bg); border: 1px solid var(--border-2);
    border-radius: 10px; padding: 0.85rem 1rem;
    overflow-x: auto; margin: 0.55rem 0; position: relative;
  }
  .msg.ai pre code {
    color: var(--code-fg); font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; line-height: 1.5; white-space: pre;
  }
  .code-copy {
    position: absolute; top: 0.5rem; right: 0.5rem;
    background: var(--bg-2); border: 1px solid var(--border-2);
    color: var(--accent); padding: 0.22rem 0.5rem;
    border-radius: 6px; font-size: 0.68rem; cursor: pointer;
    opacity: 0; transition: all .2s; font-family: inherit; font-weight: 600;
  }
  .msg.ai pre:hover .code-copy { opacity: 1; }
  .code-copy:hover { background: var(--accent); color: white; }
  .msg.typing {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 0.8rem 1.1rem; min-width: 60px;
  }
  .msg.typing .t-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); animation: typingBounce 1.4s ease-in-out infinite;
  }
  .msg.typing .t-dot:nth-child(2) { animation-delay: .2s; background: var(--accent-2); }
  .msg.typing .t-dot:nth-child(3) { animation-delay: .4s; background: var(--accent-3); }
  @keyframes typingBounce {
    0%,60%,100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }
  .cursor {
    display: inline-block; width: 2px; height: 1em;
    background: var(--accent); vertical-align: text-bottom;
    margin-left: 2px; animation: blink 1s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .msg-meta {
    display: flex; gap: 0.4rem; margin-top: 0.4rem;
    padding: 0 0.4rem; font-size: 0.72rem; color: var(--muted);
    align-items: center; flex-wrap: wrap;
    opacity: 0; transition: opacity .25s;
  }
  .msg-row:hover .msg-meta { opacity: 1; }
  .msg-action {
    background: var(--bg-3); border: 1px solid var(--border-2);
    color: var(--muted); cursor: pointer;
    font-size: 0.72rem; padding: 0.3rem 0.6rem;
    border-radius: 999px;
    display: inline-flex; align-items: center; gap: 0.3rem;
    transition: all .3s cubic-bezier(.2,.8,.2,1);
    font-family: inherit; font-weight: 600;
    position: relative; overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  .msg-action::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(120deg, var(--accent), var(--accent-2), var(--accent-3), var(--accent));
    background-size: 300% 300%;
    opacity: 0; transition: opacity .3s; z-index: 0;
    animation: gradShift 3s linear infinite;
  }
  @keyframes gradShift {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }
  .msg-action span { position: relative; z-index: 1; }
  .msg-action:hover {
    border-color: transparent;
    transform: translateY(-2px) scale(1.05);
    color: white;
    box-shadow: 0 4px 16px rgba(79,70,229,0.5);
  }
  .msg-action:hover::before { opacity: 1; }
  .msg-action:active { transform: translateY(0) scale(0.97); }
  .msg-action.done {
    color: var(--ok); border-color: var(--ok);
    background: rgba(16,185,129,0.1);
  }
  .msg-action.done::before { opacity: 0; }
  .msg-action.face-enhance { color: var(--gold); border-color: rgba(251,191,36,0.4); }
  .msg-action.face-enhance::before {
    background: linear-gradient(120deg, var(--gold), #f59e0b, var(--gold));
    background-size: 300% 300%;
  }
  .msg-action.hd { color: var(--accent-3); border-color: rgba(168,85,247,0.4); }
  .msg-action.hd::before {
    background: linear-gradient(120deg, var(--accent-3), #ec4899, var(--accent-3));
    background-size: 300% 300%;
  }
  .msg-image, .msg-video {
    background: var(--bg-2) !important;
    border: 1px solid var(--border-2) !important;
    padding: 0.5rem !important;
    display: flex; flex-direction: column; gap: 0.5rem; max-width: 100%;
  }
  .msg-image img {
    max-width: 100%; width: 100%; height: auto;
    border-radius: 12px; display: block; cursor: pointer;
    transition: transform .25s;
  }
  .msg-image img:hover { transform: scale(1.02); }
  .msg-video img {
    max-width: 100%; width: 100%;
    border-radius: 12px; display: block; cursor: pointer;
    animation: kenburns 8s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1) translate(0,0); }
    to { transform: scale(1.15) translate(-10px,-10px); }
  }
  .img-progress {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 0.8rem; background: var(--bg-3);
    border-radius: 10px; font-size: 0.82rem; color: var(--muted);
  }
  .img-progress .spinner {
    width: 16px; height: 16px;
    border: 2px solid var(--border-2);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .chat-input {
    display: flex; border-top: 1px solid var(--border);
    background: var(--bg-2); flex-shrink: 0;
    align-items: center; gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    transition: background .3s;
  }
  .chat-input.recording {
    background: linear-gradient(90deg, rgba(239,68,68,0.08), rgba(168,85,247,0.08), rgba(6,182,212,0.08), rgba(239,68,68,0.08));
    background-size: 400% 100%;
    animation: inputRainbow 4s linear infinite;
  }
  @keyframes inputRainbow {
    0% { background-position: 0% 50%; }
    100% { background-position: 400% 50%; }
  }
  .chat-input input[type="text"] {
    flex: 1; background: transparent; border: none; outline: none;
    padding: 0.7rem 0.9rem; color: var(--fg);
    font-family: inherit; font-size: 0.9rem; min-width: 0;
    border-radius: 14px; background: var(--bg-3);
    border: 1px solid var(--border);
    transition: border-color .2s;
  }
  .chat-input input[type="text"]:focus { border-color: var(--accent); }
  .chat-input input[type="text"]::placeholder { color: var(--muted); }
  .mic-btn {
    width: 56px; height: 56px; border-radius: 50%;
    border: 2px solid var(--accent); cursor: pointer;
    position: relative;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 6px 20px rgba(79,70,229,0.35);
    transition: transform .25s, box-shadow .25s;
    flex-shrink: 0; -webkit-tap-highlight-color: transparent;
    padding: 0; overflow: visible;
  }
  .mic-btn .zigzag {
    position: absolute; inset: -10px;
    width: calc(100% + 20px); height: calc(100% + 20px);
    pointer-events: none;
    animation: zigzagRotate 6s linear infinite;
    transform-origin: center;
  }
  .mic-btn .zigzag path {
    fill: none; stroke: url(#zigGrad);
    stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 4px var(--accent));
  }
  @keyframes zigzagRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .mic-btn .mic-icon {
    position: relative; z-index: 2;
    width: 24px; height: 24px;
    color: white; transition: transform .25s;
  }
  .mic-btn:hover .mic-icon { transform: scale(1.1); }
  .mic-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(79,70,229,0.55); }
  .mic-btn:active { transform: scale(0.95); }
  .mic-btn.recording {
    background: linear-gradient(135deg, var(--rec), #f43f5e, #a855f7, var(--rec));
    background-size: 300% 300%;
    animation: micGradient 1.8s ease infinite, micRecPulse 1.4s ease-in-out infinite;
    border-color: var(--rec);
  }
  @keyframes micGradient {
    0%,100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .mic-btn.recording .zigzag path {
    stroke: var(--rec);
    animation: zigzagRec 1.5s linear infinite;
  }
  @keyframes zigzagRec {
    0%,100% { stroke-width: 2.5; }
    50% { stroke-width: 4.5; }
  }
  @keyframes micRecPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.6), 0 6px 20px rgba(239,68,68,0.5); }
    50% { box-shadow: 0 0 0 14px rgba(239,68,68,0), 0 6px 24px rgba(239,68,68,0.7); }
  }
  .send-btn {
    height: 56px; padding: 0 1.6rem;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border: none; color: white;
    font-weight: 800; font-size: 0.8rem;
    letter-spacing: 2px;
    cursor: pointer; font-family: inherit;
    transition: all .25s; white-space: nowrap;
    -webkit-tap-highlight-color: transparent; flex-shrink: 0;
  }
  .send-btn:hover { box-shadow: var(--glow); }
  .send-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .send-btn.stop { background: linear-gradient(135deg, var(--err), #f43f5e); }
  .rec-overlay {
    position: fixed; inset: 0;
    background: rgba(5,8,16,0.7);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    z-index: 600; display: none;
    align-items: center; justify-content: center;
    flex-direction: column; gap: 1.5rem; padding: 1rem;
  }
  .rec-overlay.show { display: flex; }
  .rec-orb {
    position: relative;
    width: 180px; height: 180px;
    display: flex; align-items: center; justify-content: center;
  }
  .rec-orb::before {
    content: ''; position: absolute; inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--accent), var(--accent-2), var(--accent-3), var(--rec), var(--accent));
    animation: zigzagRotate 3s linear infinite;
    filter: blur(16px); opacity: 0.85;
  }
  .rec-orb::after {
    content: ''; position: absolute; inset: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #1a1f3a, #050810);
    z-index: 1;
  }
  .rec-orb-icon {
    position: relative; z-index: 2;
    font-size: 4rem;
    animation: orbPulse 1.4s ease-in-out infinite;
  }
  @keyframes orbPulse {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
  .rec-time {
    font-size: 2.4rem; font-weight: 900;
    color: white; letter-spacing: 4px;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 4px 24px rgba(239,68,68,0.6);
  }
  .rec-hint {
    color: rgba(255,255,255,0.85);
    font-size: 0.9rem; letter-spacing: 1.5px;
    text-transform: uppercase; font-weight: 600;
  }
  .rec-transcript {
    color: rgba(255,255,255,0.7);
    font-size: 0.85rem; max-width: 400px;
    text-align: center; font-style: italic;
    min-height: 1.5em;
  }
  .rec-actions { display: flex; gap: 0.75rem; margin-top: 0.5rem; }
  .rec-actions button {
    padding: 0.9rem 1.9rem; border-radius: 999px;
    font-weight: 800; font-size: 0.92rem;
    cursor: pointer; font-family: inherit;
    border: 1px solid transparent;
    -webkit-tap-highlight-color: transparent;
    transition: all .25s;
  }
  .rec-cancel {
    background: transparent; color: white;
    border-color: rgba(255,255,255,0.4);
  }
  .rec-cancel:hover { background: rgba(255,255,255,0.1); }
  .rec-send {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; box-shadow: 0 8px 24px rgba(79,70,229,0.5);
  }
  .rec-send:hover { transform: translateY(-2px); box-shadow: var(--glow); }
  .waveform {
    display: flex; align-items: center; gap: 4px; height: 70px;
  }
  .waveform .bar {
    width: 4px;
    background: linear-gradient(180deg, var(--rec), var(--accent-3), var(--accent-2));
    border-radius: 2px;
    animation: wave 1.2s ease-in-out infinite;
  }
  .waveform .bar:nth-child(1) { animation-delay: 0s; }
  .waveform .bar:nth-child(2) { animation-delay: .08s; }
  .waveform .bar:nth-child(3) { animation-delay: .16s; }
  .waveform .bar:nth-child(4) { animation-delay: .24s; }
  .waveform .bar:nth-child(5) { animation-delay: .32s; }
  .waveform .bar:nth-child(6) { animation-delay: .4s; }
  .waveform .bar:nth-child(7) { animation-delay: .32s; }
  .waveform .bar:nth-child(8) { animation-delay: .24s; }
  .waveform .bar:nth-child(9) { animation-delay: .16s; }
  .waveform .bar:nth-child(10) { animation-delay: .08s; }
  .waveform .bar:nth-child(11) { animation-delay: 0s; }
  @keyframes wave {
    0%,100% { height: 20%; }
    50% { height: 100%; }
  }
  .modal-bg {
    position: fixed; inset: 0;
    background: rgba(5,8,16,0.6);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    z-index: 500; display: none;
    align-items: center; justify-content: center;
    padding: 1rem; animation: fadeIn .25s;
  }
  .modal-bg.show { display: flex; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modal {
    background: var(--bg-2); border: 1px solid var(--border-2);
    border-radius: 20px; max-width: 560px; width: 100%;
    padding: 1.6rem;
    box-shadow: 0 30px 80px rgba(0,0,0,0.4), var(--glow);
    animation: slideIn .35s cubic-bezier(.2,.8,.2,1);
    max-height: 90vh; overflow-y: auto;
  }
  .modal h2 {
    font-size: 1.1rem; font-weight: 800;
    margin-bottom: 1rem;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .modal h3 {
    font-size: 0.9rem; font-weight: 700;
    margin-top: 1rem; margin-bottom: 0.5rem;
    color: var(--accent);
  }
  .modal label {
    display: block; font-size: 0.78rem;
    color: var(--muted); margin-bottom: 0.4rem;
    margin-top: 1rem; font-weight: 600;
  }
  .modal input[type="text"],
  .modal input[type="number"],
  .modal textarea {
    width: 100%;
    background: var(--bg-3); border: 1px solid var(--border-2);
    border-radius: 12px; padding: 0.75rem 0.9rem;
    color: var(--fg); font-family: inherit;
    font-size: 0.88rem; line-height: 1.6; outline: none;
    transition: border-color .2s;
  }
  .modal textarea { min-height: 100px; resize: vertical; }
  .modal input:focus, .modal textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
  }
  .modal-actions {
    display: flex; gap: 0.6rem;
    justify-content: flex-end; margin-top: 1.2rem;
  }
  .modal-actions button {
    padding: 0.68rem 1.35rem; border-radius: 10px;
    font-weight: 700; font-size: 0.83rem;
    cursor: pointer; font-family: inherit;
    border: 1px solid transparent;
    -webkit-tap-highlight-color: transparent;
    transition: all .2s;
  }
  .modal-actions .cancel {
    background: transparent; color: var(--muted);
    border-color: var(--border-2);
  }
  .modal-actions .cancel:hover { color: var(--err); border-color: var(--err); }
  .modal-actions .save {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white;
  }
  .modal-actions .save:hover { box-shadow: var(--glow); transform: translateY(-1px); }
  .voice-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0; font-size: 0.85rem; }
  .toggle {
    position: relative;
    width: 44px; height: 24px;
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 999px; cursor: pointer;
    transition: all .25s; flex-shrink: 0;
  }
  .toggle::after {
    content: ''; position: absolute;
    top: 2px; left: 2px;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--muted);
    transition: all .25s;
  }
  .toggle.on {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: var(--accent);
  }
  .toggle.on::after { left: 22px; background: white; }
  .lang-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.5rem; margin-top: 0.5rem;
  }
  .lang-option {
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 10px;
    padding: 0.6rem 0.8rem;
    cursor: pointer; font-family: inherit;
    color: var(--fg); text-align: left;
    font-size: 0.82rem;
    transition: all .2s;
    -webkit-tap-highlight-color: transparent;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .lang-option:hover { border-color: var(--accent); background: var(--bg-2); }
  .lang-option.active {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; box-shadow: var(--glow);
  }
  .lang-option .lang-flag { font-size: 1.1rem; }
  .size-grid { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .size-opt {
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 10px;
    padding: 0.55rem 0.9rem;
    cursor: pointer; font-family: inherit;
    color: var(--fg); font-size: 0.8rem;
    transition: all .2s;
    display: flex; flex-direction: column;
    align-items: center; gap: 0.15rem;
    min-width: 90px;
  }
  .size-opt:hover { border-color: var(--accent); }
  .size-opt.active {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; box-shadow: var(--glow);
  }
  .size-opt small { font-size: 0.68rem; opacity: 0.8; }
  .model-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.5rem; margin-top: 0.5rem;
  }
  .model-opt {
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    cursor: pointer; font-family: inherit;
    color: var(--fg); text-align: left;
    font-size: 0.8rem;
    transition: all .2s;
    -webkit-tap-highlight-color: transparent;
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .model-opt:hover { border-color: var(--accent); background: var(--bg-2); }
  .model-opt.active {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; box-shadow: var(--glow);
  }
  .model-opt .m-name { font-weight: 700; }
  .model-opt .m-desc { font-size: 0.68rem; opacity: 0.75; }
  .model-opt.active .m-desc { opacity: 0.9; }
  .profile-header {
    display: flex; align-items: center; gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .profile-avatar {
    width: 60px; height: 60px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 800; font-size: 1.5rem;
    flex-shrink: 0; position: relative;
  }
  .profile-avatar.admin::after {
    content: '👑';
    position: absolute; top: -8px; right: -8px;
    font-size: 1.2rem;
    filter: drop-shadow(0 0 6px rgba(251,191,36,0.8));
  }
  .profile-info { display: flex; flex-direction: column; gap: 0.2rem; }
  .profile-name { font-size: 1.1rem; font-weight: 800; }
  .profile-email { font-size: 0.8rem; color: var(--muted); }
  .profile-role {
    display: inline-flex; align-items: center; gap: 0.3rem;
    background: linear-gradient(135deg, var(--gold), #f59e0b);
    color: white; padding: 0.15rem 0.5rem;
    border-radius: 999px; font-size: 0.7rem;
    font-weight: 800; margin-top: 0.3rem;
    width: fit-content;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.6rem; margin-top: 1rem;
  }
  .stat-card {
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 12px;
    padding: 0.9rem 0.7rem;
    text-align: center;
  }
  .stat-value {
    font-size: 1.5rem; font-weight: 900;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; line-height: 1.1;
  }
  .stat-label {
    font-size: 0.68rem; color: var(--muted);
    letter-spacing: 0.5px; margin-top: 0.3rem;
    text-transform: uppercase;
  }
  .ad-item {
    background: var(--bg-3); border: 1px solid var(--border-2);
    border-radius: 12px; padding: 0.8rem;
    margin-bottom: 0.6rem;
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .ad-item-header { display: flex; justify-content: space-between; align-items: center; }
  .ad-item-title { font-weight: 700; font-size: 0.88rem; }
  .ad-item-actions { display: flex; gap: 0.3rem; }
  .ad-item-actions button {
    background: transparent; border: 1px solid var(--border-2);
    color: var(--muted); padding: 0.25rem 0.5rem;
    border-radius: 6px; cursor: pointer; font-size: 0.72rem;
    font-family: inherit;
  }
  .ad-item-actions .del { color: var(--err); border-color: rgba(225,29,72,0.3); }
  .ad-item-body { font-size: 0.8rem; color: var(--muted); }
  .ad-fullscreen {
    position: fixed; inset: 0;
    background: rgba(5,8,16,0.95);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    z-index: 1000; display: none;
    flex-direction: column;
    align-items: center; justify-content: center;
    padding: 2rem; animation: fadeIn .3s;
  }
  .ad-fullscreen.show { display: flex; }
  .ad-content {
    max-width: 600px; width: 100%;
    background: var(--bg-2);
    border: 2px solid var(--accent);
    border-radius: 24px;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 0 80px rgba(79,70,229,0.5);
    animation: adPop .4s cubic-bezier(.2,.8,.2,1);
    position: relative;
  }
  @keyframes adPop {
    from { transform: scale(0.85); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .ad-badge {
    position: absolute; top: 1rem; left: 1rem;
    background: linear-gradient(135deg, var(--gold), #f59e0b);
    color: white; padding: 0.25rem 0.7rem;
    border-radius: 999px; font-size: 0.7rem;
    font-weight: 800; letter-spacing: 1px;
  }
  .ad-image {
    max-width: 100%; max-height: 300px;
    border-radius: 16px; margin-bottom: 1rem;
    object-fit: cover;
  }
  .ad-title {
    font-size: 1.5rem; font-weight: 900;
    margin-bottom: 0.5rem;
    background: linear-gradient(120deg, var(--accent), var(--accent-2), var(--accent-3));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .ad-desc {
    font-size: 0.95rem; color: var(--muted);
    margin-bottom: 1.5rem; line-height: 1.6;
  }
  .ad-cta {
    display: inline-block;
    padding: 0.9rem 2rem; border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; text-decoration: none;
    font-weight: 800; font-size: 0.95rem;
    letter-spacing: 1px; transition: all .25s;
  }
  .ad-cta:hover { transform: translateY(-2px); box-shadow: var(--glow); }
  .ad-skip {
    position: absolute; top: 1rem; right: 1rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.3);
    color: white; width: 40px; height: 40px;
    border-radius: 50%; cursor: pointer;
    font-size: 1rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    transition: all .25s;
    -webkit-tap-highlight-color: transparent;
  }
  .ad-skip:disabled { opacity: 0.4; cursor: not-allowed; }
  .ad-skip:not(:disabled):hover { background: rgba(255,255,255,0.2); }
  .auth-box {
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
    margin-top: 0.5rem;
  }
  .auth-box p {
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }
  .auth-box button {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white; border: none;
    padding: 0.7rem 1.5rem; border-radius: 10px;
    font-weight: 700; font-size: 0.85rem;
    cursor: pointer; font-family: inherit;
    transition: all .25s;
    width: 100%;
  }
  .auth-box button:hover { transform: translateY(-1px); box-shadow: var(--glow); }
  .auth-box button.logout {
    background: transparent;
    border: 1px solid rgba(225,29,72,0.4);
    color: var(--err);
  }
  .auth-box button.logout:hover {
    background: var(--err); color: white;
    box-shadow: 0 0 24px rgba(225,29,72,0.5);
  }
  .auth-box .signed-info {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
    color: var(--fg);
  }
  .toast {
    position: fixed; bottom: 90px; left: 50%;
    transform: translateX(-50%) translateY(90px);
    background: var(--bg-2); border: 1px solid var(--accent);
    color: var(--accent); padding: 0.7rem 1.5rem;
    border-radius: 999px; font-size: 0.82rem; font-weight: 700;
    z-index: 999; transition: transform .35s;
    pointer-events: none; box-shadow: var(--glow);
    max-width: 90vw; text-align: center;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
  @media (max-width: 900px) {
    .layout { padding: 0.75rem; gap: 0.75rem; }
    .sidebar {
      position: fixed; top: 60px; left: 0; bottom: 0;
      width: 280px; z-index: 90;
      border-radius: 0 20px 20px 0;
      transform: translateX(-100%);
      transition: transform .3s ease;
      box-shadow: 20px 0 60px rgba(0,0,0,0.3);
    }
    .sidebar.open { transform: translateX(0); }
    .sidebar > * { min-width: 0; }
  }
  @media (max-width: 640px) {
    .nav { padding: 0.7rem 1rem; }
    .brand { font-size: 1rem; letter-spacing: 3px; }
    .chat-wrap { border-radius: 18px; }
    .msg-col { max-width: 92%; }
    .icon-tool { width: 36px; height: 36px; }
    .icon-tool svg { width: 16px; height: 16px; }
    .welcome { padding: 1.5rem 0.5rem 0.5rem; }
    .welcome-icon { width: 56px; height: 56px; font-size: 1.5rem; }
    .quick-grid { grid-template-columns: repeat(2, 1fr); gap: 0.4rem; }
    .quick-card { padding: 0.6rem 0.7rem; }
    .mic-btn { width: 50px; height: 50px; }
    .mic-btn .zigzag { inset: -8px; width: calc(100% + 16px); height: calc(100% + 16px); }
    .mic-btn .mic-icon { width: 20px; height: 20px; }
    .send-btn { height: 50px; padding: 0 1.2rem; font-size: 0.72rem; }
    .chat-input { gap: 0.4rem; padding: 0.5rem 0.6rem; }
    .rec-orb { width: 140px; height: 140px; }
    .rec-orb-icon { font-size: 3rem; }
    .rec-time { font-size: 1.8rem; }
  }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    border-radius: 4px;
  }
</style>
</head>
<body>

<div class="bg-layer">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
</div>

<header>
  <div class="nav">
    <div class="nav-left">
      <button class="icon-tool" id="sidebarToggle" title="Toggle sidebar" type="button">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <a href="index.html" class="brand">
        <div class="brand-mark">◆</div>
        DARK
      </a>
    </div>
    <div class="nav-actions">
      <div class="auth-badge" id="authBadge" style="display:none">
        <span class="avatar-sm" id="authAvatar">U</span>
        <span id="authName">User</span>
      </div>
    </div>
  </div>
</header>

<div class="layout">
  <aside class="sidebar" id="sidebar">
    <div class="user-card" id="userCard" style="display:none">
      <div class="avatar-lg" id="userAvatar">U</div>
      <div class="info">
        <div class="name" id="userName">User</div>
        <div class="sub" id="userSub">Signed in</div>
      </div>
      <span class="crown" id="userCrown" style="display:none">👑</span>
    </div>
    <button class="new-chat" id="newChat" type="button">＋ New Chat</button>
    <input type="text" class="search-box" id="searchBox" placeholder="Search chats…" />
    <div class="chat-list" id="chatList"></div>
    <div class="sidebar-footer">
      <button class="sidebar-btn admin" id="adminBtn" type="button" style="display:none">👑 Admin Panel</button>
      <button class="sidebar-btn" id="exportAllBtn" type="button">⬇ Export all</button>
      <button class="sidebar-btn" id="clearAllBtn" type="button">🗑 Clear all chats</button>
    </div>
  </aside>

  <div class="chat-area">
    <div class="chat-wrap">
      <div class="chat-head">
        <div class="status-dot"></div>
        <div class="chat-head-title">
          <b>DARK AI</b>
          <small id="chatStatus">Connecting…</small>
        </div>
        <div class="chat-tools">
          <button class="icon-tool" id="btnVideo" title="Generate video" type="button">
            <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          </button>
          <button class="icon-tool" id="btnImage" title="Generate image" type="button">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </button>
          <button class="icon-tool save" id="btnSave" title="Save chat" type="button">
            <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          </button>
          <button class="icon-tool" id="btnSettings" title="Settings" type="button">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </button>
          <button class="icon-tool danger" id="btnClear" title="Clear chat" type="button">
            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </button>
        </div>
      </div>

      <div class="chat-body" id="chatBody">
        <div class="welcome" id="welcome">
          <div class="welcome-icon">◆</div>
          <h1>Chat, speak, <span class="grad">create HD anything</span>.</h1>
          <p>Arabic, English, Amharic & more. Professional images and videos with face enhancement.</p>
          <div class="quick-grid" id="quickGrid"></div>
        </div>
      </div>

      <div class="chat-input" id="chatInputWrap">
        <button class="mic-btn" id="micBtn" title="Continuous voice mode" type="button">
          <svg class="zigzag" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="zigGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#4f46e5"/>
                <stop offset="50%" stop-color="#06b6d4"/>
                <stop offset="100%" stop-color="#a855f7"/>
              </linearGradient>
            </defs>
            <path d="M 50 4 L 58 10 L 66 4 L 74 10 L 82 4 L 90 10 L 94 20 L 90 30 L 96 38 L 90 46 L 96 54 L 90 62 L 96 70 L 90 78 L 94 88 L 86 94 L 78 88 L 70 94 L 62 88 L 54 94 L 46 88 L 38 94 L 30 88 L 22 94 L 14 88 L 10 78 L 4 70 L 10 62 L 4 54 L 10 46 L 4 38 L 10 30 L 4 20 L 10 12 L 18 6 Z" />
          </svg>
          <svg class="mic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="23"/>
            <line x1="8" y1="23" x2="16" y2="23"/>
          </svg>
        </button>
        <input id="chatInput" type="text" placeholder="Type, speak, or say 'generate image of …'…" autocomplete="off" />
        <button class="send-btn" id="sendBtn" type="button">SEND</button>
      </div>
    </div>
  </div>
</div>

<div class="rec-overlay" id="recOverlay">
  <div class="rec-orb"><span class="rec-orb-icon">🎤</span></div>
  <div class="rec-time" id="recTime">0:00</div>
  <div class="waveform" id="waveform">
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    <span class="bar"></span><span class="bar"></span>
  </div>
  <div class="rec-hint" id="recHint">Listening…</div>
  <div class="rec-transcript" id="recTranscript"></div>
  <div class="rec-actions">
    <button class="rec-cancel" id="recCancel" type="button">✕ Stop</button>
    <button class="rec-send" id="recSend" type="button">✓ Send now</button>
  </div>
</div>

<div class="modal-bg" id="settingsModal">
  <div class="modal">
    <h2>⚙ SETTINGS</h2>
    <h3>👤 Account</h3>
    <div class="auth-box" id="authBox"></div>
    <label for="systemPrompt">System Prompt</label>
    <textarea id="systemPrompt"></textarea>
    <label>Preferred Reply Language</label>
    <div class="lang-grid" id="langGrid"></div>
    <label>Image Quality</label>
    <div class="model-grid" id="imageQualityGrid"></div>
    <label>Image Size</label>
    <div class="size-grid" id="sizeGrid"></div>
    <h3>Voice & Audio</h3>
    <div class="voice-row">
      <div class="toggle" id="autoSpeakToggle"></div>
      <span>Auto-speak AI replies</span>
    </div>
    <h3>Appearance</h3>
    <div class="voice-row">
      <div class="toggle" id="themeToggle"></div>
      <span>Dark mode</span>
    </div>
    <div class="modal-actions">
      <button class="cancel" id="settingsCancel" type="button">Cancel</button>
      <button class="save" id="settingsSave" type="button">Save</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="profileModal">
  <div class="modal">
    <h2>👤 PROFILE</h2>
    <div class="profile-header">
      <div class="profile-avatar" id="profileAvatar">U</div>
      <div class="profile-info">
        <div class="profile-name" id="profileName">User</div>
        <div class="profile-email" id="profileEmail">—</div>
        <div class="profile-role" id="profileRole" style="display:none">👑 ADMIN</div>
      </div>
    </div>
    <div class="stats-grid" id="profileStats"></div>
    <div class="modal-actions">
      <button class="cancel" id="profileClose" type="button">Close</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="adminModal">
  <div class="modal" style="max-width: 640px;">
    <h2>👑 ADMIN PANEL</h2>
    <h3>📊 Statistics</h3>
    <div class="stats-grid" id="adminStats"></div>
    <h3>🔗 Quick Actions</h3>
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.5rem; margin-bottom:1rem;">
  <button class="sidebar-btn" id="viewSiteBtn" type="button">🌐 View Site</button>
  <button class="sidebar-btn" id="exportDataBtn" type="button">💾 Export Data</button>
  <button class="sidebar-btn" id="importDataBtn" type="button">📥 Import Data</button>
  <button class="sidebar-btn" id="resetStatsBtn" type="button">📊 Reset Stats</button>
</div><h3>📢 Advertisements</h3>
    <div id="adList" style="margin-top: 0.5rem;"></div>
    <button class="sidebar-btn" id="addAdBtn" type="button" style="margin-top: 0.5rem;">＋ Add New Ad</button>
    <div class="modal-actions">
      <button class="cancel" id="adminClose" type="button">Close</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="adEditModal">
  <div class="modal">
    <h2 id="adEditTitle">📢 NEW AD</h2>
    <label>Title</label>
    <input type="text" id="adTitle" placeholder="Special Offer!" />
    <label>Description</label>
    <textarea id="adDesc" placeholder="Visit our store…"></textarea>
    <label>Image URL (optional)</label>
    <input type="text" id="adImage" placeholder="https://…" />
    <label>CTA Link</label>
    <input type="text" id="adLink" placeholder="https://…" />
    <label>CTA Text</label>
    <input type="text" id="adCta" placeholder="Learn More" />
    <label>Show every N messages</label>
    <input type="number" id="adFreq" value="10" min="1" />
    <div class="modal-actions">
      <button class="cancel" id="adEditCancel" type="button">Cancel</button>
      <button class="save" id="adEditSave" type="button">Save</button>
    </div>
  </div>
</div>

<div class="ad-fullscreen" id="adFullscreen">
  <div class="ad-content">
    <div class="ad-badge">SPONSORED</div>
    <button class="ad-skip" id="adSkip" disabled>5</button>
    <img class="ad-image" id="adFsImage" src="" alt="" style="display:none" />
    <h2 class="ad-title" id="adFsTitle">Special Offer</h2>
    <p class="ad-desc" id="adFsDesc">Check out this amazing deal!</p>
    <a class="ad-cta" id="adFsCta" href="#" target="_blank" rel="noopener">Learn More</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ============================================================
  // DARK AI v16.0 — Full JavaScript
  // ============================================================
  const PROXY_URL = '/chat';
  const WHISPER_URL = '/transcribe';
  const ADMIN_USERS = ['seyaboss1', 'seyaboss1@gmail.com', 'creative_mountain_405049'];
  const LANGUAGES = [
    { code: 'auto', name: 'Auto-detect', native: 'Auto',     flag: '🌐', tts: '' },
    { code: 'ar',   name: 'Arabic',      native: 'العربية',  flag: '🇸🇦', tts: 'ar-SA' },
    { code: 'en',   name: 'English',     native: 'English',  flag: '🇬🇧', tts: 'en-US' },
    { code: 'am',   name: 'Amharic',     native: 'አማርኛ',     flag: '🇪🇹', tts: 'am-ET' },
    { code: 'fr',   name: 'French',      native: 'Français', flag: '🇫🇷', tts: 'fr-FR' },
    { code: 'es',   name: 'Spanish',     native: 'Español',  flag: '🇪🇸', tts: 'es-ES' },
    { code: 'de',   name: 'German',      native: 'Deutsch',  flag: '🇩🇪', tts: 'de-DE' },
    { code: 'tr',   name: 'Turkish',     native: 'Türkçe',   flag: '🇹🇷', tts: 'tr-TR' },
    { code: 'hi',   name: 'Hindi',       native: 'हिन्दी',    flag: '🇮🇳', tts: 'hi-IN' },
    { code: 'zh',   name: 'Chinese',     native: '中文',     flag: '🇨🇳', tts: 'zh-CN' },
    { code: 'ja',   name: 'Japanese',    native: '日本語',   flag: '🇯🇵', tts: 'ja-JP' },
    { code: 'ru',   name: 'Russian',     native: 'Русский',  flag: '🇷🇺', tts: 'ru-RU' }
  ];

  const IMAGE_SIZES = [
    { code: 'square',    name: 'Square', dim: '1024×1024', w: 1024, h: 1024 },
    { code: 'landscape', name: 'Wide',   dim: '1280×720',  w: 1280, h: 720  },
    { code: 'portrait',  name: 'Tall',   dim: '720×1280',  w: 720,  h: 1280 },
    { code: 'hd',        name: 'HD',     dim: '1920×1080', w: 1920, h: 1080 }
  ];

  const IMAGE_QUALITY = [
    { code: 'turbo',        name: 'Turbo',     desc: 'Fast + sharp' },
    { code: 'flux',         name: 'Flux',      desc: 'Best quality' },
    { code: 'flux-realism', name: 'Realism',   desc: 'Photoreal' },
    { code: 'flux-pro',     name: 'Flux Pro',  desc: 'Premium' }
  ];

  let preferredLang = localStorage.getItem('dark-lang') || 'auto';
  let preferredSize = localStorage.getItem('dark-size') || 'hd';
  let preferredQuality = localStorage.getItem('dark-quality') || 'turbo';
  let autoSpeak = localStorage.getItem('dark-autospeak') === 'true';
  let theme = localStorage.getItem('dark-theme') || 'light';
  let currentUser = null;
  let isAdmin = false;
  let threads = {};
  let activeId = null;
  let busy = false;
  let abortController = null;
  let searchQuery = '';

  let mediaRecorder = null;
  let recordedChunks = [];
  let recTimerInterval = null;
  let recSeconds = 0;
  let audioStream = null;
  let voiceModeActive = false;
  let analyser = null;
  let audioContext = null;
  let silenceCheckInterval = null;

  let ads = JSON.parse(localStorage.getItem('dark-ads') || '[]');
  let messageCounter = parseInt(localStorage.getItem('dark-msg-counter') || '0');

  const $ = (id) => document.getElementById(id);

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[c]));
  }

  function toast(msg) {
    const t = $('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
  }

  function setStatus(t, ok = true) {
    const el = $('chatStatus');
    el.textContent = t;
    el.style.color = ok ? 'var(--muted)' : 'var(--err)';
  }

  function detectLanguage(text) {
    if (!text) return null;
    if (/[\u1200-\u137F\u1380-\u139F\u2D80-\u2DDF\uAB00-\uAB2F]/.test(text)) return 'am';
    if (/[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF]/.test(text)) return 'ar';
    if (/[\u0400-\u04FF]/.test(text)) return 'ru';
    if (/[\u0900-\u097F]/.test(text)) return 'hi';
    if (/[\u4E00-\u9FFF\u3040-\u30FF]/.test(text)) return /[\u3040-\u30FF]/.test(text) ? 'ja' : 'zh';
    if (/[ğüşıöçĞÜŞİÖÇ]/.test(text)) return 'tr';
    if (/[éèêëàâîïôûùçÉÈÊËÀÂÎÏÔÛÙÇ]/.test(text)) return 'fr';
    if (/[äöüßÄÖÜ]/.test(text)) return 'de';
    if (/[ñáéíóúüÑÁÉÍÓÚ]/.test(text)) return 'es';
    if (/[a-zA-Z]/.test(text)) return 'en';
    return null;
  }

  function enhancePrompt(prompt, type = 'image') {
    let p = prompt.trim();
    const fixes = [
      [/\bdogg\b/gi, 'dog'], [/\bcattt\b/gi, 'cat'],
      [/\brunnig\b/gi, 'running'], [/\bruning\b/gi, 'running'],
      [/\bwalkin\b/gi, 'walking'],
      [/\bصوه\b/g, 'صورة'], [/\bصوره\b/g, 'صورة'], [/\bفديو\b/g, 'فيديو']
    ];
    fixes.forEach(([re, rep]) => { p = p.replace(re, rep); });

    if (type === 'image') {
      const hasQuality = /(?:8k|4k|detailed|cinematic|masterpiece|hyperrealistic|ultra)/i.test(p);
      const hasFace = /(?:face|portrait|woman|man|girl|boy|person|رجل|امرأة|فتاة|ولد|وجه|بورتريه)/i.test(p);
      const hasLight = /(?:lighting|light|shadow|golden|sunset|sunrise|إضاءة|ضوء)/i.test(p);
      if (hasFace) {
        p += ', detailed face, symmetrical features, sharp eyes, natural skin texture, professional portrait photography, 85mm lens, f/1.8, shallow depth of field';
      }
      if (!hasLight) {
        p += ', cinematic lighting, volumetric light, dramatic shadows';
      }
      if (!hasQuality) {
        p += ', 8k resolution, hyperrealistic, ultra detailed, masterpiece, sharp focus';
      }
    } else {
      p += ', cinematic, smooth motion, high quality, sharp focus, professional';
    }
    return p;
  }

  function buildNegativePrompt() {
    return 'blurry, low quality, distorted, deformed, ugly, bad anatomy, extra fingers, extra limbs, watermark, text, logo, jpeg artifacts, oversaturated, cartoon';
  }

  function detectImageIntent(text) {
    const patterns = [
      /^generate\s+(?:an?\s+)?image\s+(?:of\s+)?(.+)/i,
      /^create\s+(?:an?\s+)?image\s+(?:of\s+)?(.+)/i,
      /^draw\s+(.+)/i,
      /^make\s+(?:an?\s+)?image\s+(?:of\s+)?(.+)/i,
      /^picture\s+of\s+(.+)/i,
      /^image\s+of\s+(.+)/i,
      /^paint\s+(.+)/i,
      /^(?:صمم|أنشئ|اعمل|ارسم)\s+(?:لي\s+)?(?:صورة|صوره)\s*(?:ل|عن|من)?\s*(.+)/i,
      /^صورة\s+(?:ل|عن|من)\s*(.+)/i,
      /^(?:صمم|ارسم)\s+(.+)/i,
      /^ስዕል\s+(?:ስራ|ስሩ|አዘጋጅ)\s*(.+)/i,
      /^ስልት\s+(.+)/i,
      /^(?:ስዕል|ምስል)\s+(.+)/i
    ];
    for (const pattern of patterns) {
      const m = text.match(pattern);
      if (m) {
        const prompt = m[m.length - 1].trim();
        if (prompt.length > 2) return prompt;
      }
    }
    return null;
  }

  function detectVideoIntent(text) {
    const patterns = [
      /^generate\s+(?:a\s+)?video\s+(?:of\s+)?(.+)/i,
      /^create\s+(?:a\s+)?video\s+(?:of\s+)?(.+)/i,
      /^make\s+(?:a\s+)?video\s+(?:of\s+)?(.+)/i,
      /^animate\s+(.+)/i,
      /^(?:صمم|أنشئ|اعمل)\s+(?:لي\s+)?فيديو\s*(?:ل|عن|من)?\s*(.+)/i,
      /^فيديو\s+(?:ل|عن|من)\s*(.+)/i,
      /^ቪዲዮ\s+(?:ስራ|ስሩ|አዘጋጅ)\s*(.+)/i
    ];
    for (const pattern of patterns) {
      const m = text.match(pattern);
      if (m) {
        const prompt = m[m.length - 1].trim();
        if (prompt.length > 2) return prompt;
      }
    }
    return null;
  }

  function buildSystemPrompt() {
    const saved = localStorage.getItem('dark-prompt');
    if (saved) return saved;
    const base =
      'You are DARK, an elite multilingual AI assistant with native fluency in Arabic, English, and Amharic. ' +
      'You have BUILT-IN PRO IMAGE and VIDEO GENERATORS. ' +
      'To generate images: "صمم صورة [وصف]" / "generate image of [description]". ' +
      'To generate videos: "صمم فيديو [وصف]" / "generate video of [description]". ' +
      'Users can click "HD" to regenerate at 2048×2048, or "Face Enhance" to fix faces. ' +
      'If user asks about capabilities, respond YES and give the exact command. NEVER say you cannot. ';
    const amharicRules =
      'AMHARIC RULES: Use correct grammar — SOV order, verb conjugations, definite articles (-ው, -ዋ, -ዎቹ), prepositions (በ-, ለ-, ከ-, ወደ-). NEVER mix with English. ';
    let langRule;
    if (preferredLang === 'auto') {
      langRule = 'MULTILINGUAL RULE: Detect the language of the user\'s LAST message and reply ENTIRELY in that SAME language. ';
    } else if (preferredLang === 'am') {
      langRule = 'MULTILINGUAL RULE: ALWAYS reply in fluent Amharic. ';
    } else {
      const l = LANGUAGES.find(x => x.code === preferredLang);
      langRule = 'MULTILINGUAL RULE: ALWAYS reply in ' + l.name + ' (' + l.native + '). ';
    }
    return base + amharicRules + langRule +
      'Be direct, confident, helpful. Use short paragraphs. When giving code, use markdown code blocks.';
  }

  const quickPrompts = [
    { emoji: '👤', title: 'Who are you', desc: 'Learn about DARK', prompt: 'Who are you?' },
    { emoji: '💬', title: 'مرحبا', desc: 'Talk in Arabic', prompt: 'مرحبا، كيف حالك؟' },
    { emoji: '🇪🇹', title: 'ሰላም', desc: 'Talk in Amharic', prompt: 'ሰላም፣ እንዴት ነህ?' },
    { emoji: '🎨', title: 'HD Portrait', desc: 'Professional face', prompt: 'generate image of a beautiful young woman with detailed face, professional portrait' },
    { emoji: '🎬', title: 'Cinematic Video', desc: 'Short video', prompt: 'generate video of a lion walking in African savanna at golden hour' },
    { emoji: '💻', title: 'Write code', desc: 'Python, JS', prompt: 'Write a Python function that reverses a string.' }
  ];

  function buildQuickGrid(container) {
    container.innerHTML = '';
    quickPrompts.forEach(p => {
      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'quick-card';
      card.innerHTML = '<span class="qc-emoji">' + p.emoji + '</span>' +
        '<span class="qc-text"><span class="qc-title">' + p.title + '</span>' +
        '<span class="qc-desc">' + p.desc + '</span></span>';
      card.onclick = () => {
        $('chatInput').value = p.prompt;
        $('chatInput').focus();
        sendMsg();
      };
      container.appendChild(card);
    });
  }

  function applyTheme() {
    document.body.dataset.theme = theme === 'dark' ? 'dark' : '';
    localStorage.setItem('dark-theme', theme);
  }
  applyTheme();

  function speak(text) {
    if (!window.speechSynthesis) return;
    speechSynthesis.cancel();
    const clean = text.replace(/```[\s\S]*?```/g, 'code block')
                      .replace(/`([^`]+)`/g, '$1')
                      .replace(/[*_#>]/g, '');
    const detected = detectLanguage(clean);
    let langCode = 'en-US';
    if (detected) {
      const l = LANGUAGES.find(x => x.code === detected);
      if (l && l.tts) langCode = l.tts;
    } else if (preferredLang !== 'auto') {
      const l = LANGUAGES.find(x => x.code === preferredLang);
      if (l && l.tts) langCode = l.tts;
    }
    const u = new SpeechSynthesisUtterance(clean);
    u.lang = langCode; u.rate = 1.0; u.pitch = 1.0;
    speechSynthesis.speak(u);
  }

  function renderMarkdown(text) {
    let html = escapeHtml(text);
    const codeBlocks = [];
    html = html.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
      const idx = codeBlocks.length;
      codeBlocks.push({ code: code.replace(/\n$/, '') });
      return `\u0000CB${idx}\u0000`;
    });
    html = html.replace(/`([^`\n]+)`/g, '<code class="inline">$1</code>');
    html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
    html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
    html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
    html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    html = html.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>\n?)+/g, m => '<ul>' + m + '</ul>');
    html = html.split(/\n{2,}/).map(p => {
      if (/^\s*<(h[1-3]|ul|ol|pre)/.test(p.trim())) return p;
      return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
    }).join('');
    html = html.replace(/\u0000CB(\d+)\u0000/g, (_, i) => {
      const { code } = codeBlocks[+i];
      const encoded = encodeURIComponent(code);
      return `<pre data-code="${encoded}"><button class="code-copy" type="button" onclick="copyCode(this)">COPY</button><code>${escapeHtml(code)}</code></pre>`;
    });
    return html;
  }

  window.copyCode = function(btn) {
    const pre = btn.closest('pre');
    const code = decodeURIComponent(pre.dataset.code);
    navigator.clipboard.writeText(code).then(() => {
      btn.textContent = 'COPIED'; btn.style.color = 'var(--ok)';
      setTimeout(() => { btn.textContent = 'COPY'; btn.style.color = ''; }, 1400);
      toast('Code copied');
    });
  };

  function loadThreads() {
    try { threads = JSON.parse(localStorage.getItem('dark-threads') || '{}') || {}; } catch (e) { threads = {}; }
    activeId = localStorage.getItem('dark-active') || null;
    if (!activeId || !threads[activeId]) {
      if (Object.keys(threads).length === 0) createThread(true);
      else activeId = Object.keys(threads)[0];
    }
  }

  async function saveThreads() {
    localStorage.setItem('dark-threads', JSON.stringify(threads));
    localStorage.setItem('dark-active', activeId);
    try {
      if (window.puter && puter.auth && await puter.auth.isSignedIn()) {
        await puter.kv.set('dark-threads', JSON.stringify(threads));
        await puter.kv.set('dark-active', activeId);
      }
    } catch (e) {}
  }

  function createThread(silent = false) {
    const id = 't_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
    threads[id] = {
      title: 'New chat',
      messages: [{ role: 'system', content: buildSystemPrompt() }],
      createdAt: Date.now()
    };
    activeId = id;
    saveThreads();
    if (!silent) {
      renderThreads(); rebuildUI(); toast('New chat created');
      if (window.innerWidth <= 900) $('sidebar').classList.remove('open');
    }
  }

  function deleteThread(id, e) {
    if (e) e.stopPropagation();
    if (!confirm('Delete this chat?')) return;
    delete threads[id];
    if (activeId === id) {
      const remaining = Object.keys(threads);
      if (remaining.length === 0) createThread(true);
      else activeId = remaining[0];
    }
    saveThreads(); renderThreads(); rebuildUI(); toast('Chat deleted');
  }

  function switchThread(id) {
    if (busy) { toast('Wait for current reply'); return; }
    activeId = id; saveThreads(); renderThreads(); rebuildUI();
    if (window.innerWidth <= 900) $('sidebar').classList.remove('open');
  }

  function renderThreads() {
    const list = $('chatList');
    list.innerHTML = '';
    const ids = Object.keys(threads)
      .filter(id => !searchQuery || threads[id].title.toLowerCase().includes(searchQuery))
      .sort((a, b) => threads[b].createdAt - threads[a].createdAt);
    ids.forEach(id => {
      const t = threads[id];
      const item = document.createElement('div');
      item.className = 'chat-item' + (id === activeId ? ' active' : '');
      item.innerHTML = '<span>' + escapeHtml(t.title) + '</span>';
      const del = document.createElement('button');
      del.type = 'button'; del.className = 'del'; del.innerHTML = '×';
      del.onclick = (e) => deleteThread(id, e);
      item.appendChild(del);
      item.onclick = () => switchThread(id);
      list.appendChild(item);
    });
  }

  function hideWelcome() { const w = $('welcome'); if (w) w.remove(); }
  function scrollBottom() { const cb = $('chatBody'); cb.scrollTop = cb.scrollHeight; }

  function renderUserMsg(text) {
    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row user';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const m = document.createElement('div');
    m.className = 'msg user';
    m.textContent = text;
    col.appendChild(m); row.appendChild(col); $('chatBody').appendChild(row); scrollBottom();
  }

  function buildMeta(text, tokens) {
  const meta = document.createElement('div');
  meta.className = 'msg-meta';

  const copyBtn = document.createElement('button');
  copyBtn.type = 'button'; copyBtn.className = 'msg-action';
  copyBtn.innerHTML = '<span>📋</span><span>Copy</span>';
  copyBtn.onclick = () => {
    navigator.clipboard.writeText(text).then(() => {
      copyBtn.classList.add('done');
      copyBtn.innerHTML = '<span>✓</span><span>Copied</span>';
      setTimeout(() => {
        copyBtn.classList.remove('done');
        copyBtn.innerHTML = '<span>📋</span><span>Copy</span>';
      }, 1600);
    });
  };
  meta.appendChild(copyBtn);
    const meta = document.createElement('div');
    meta.className = 'msg-meta';

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button'; copyBtn.className = 'msg-action';
    copyBtn.innerHTML = '<span>📋</span><span>Copy</span>';
    copyBtn.onclick = () => {
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.classList.add('done');
        copyBtn.innerHTML = '<span>✓</span><span>Copied</span>';
        setTimeout(() => {
          copyBtn.classList.remove('done');
          copyBtn.innerHTML = '<span>📋</span><span>Copy</span>';
        }, 1600);
      });
    };
    meta.appendChild(copyBtn);

    const speakBtn = document.createElement('button');
    speakBtn.type = 'button'; speakBtn.className = 'msg-action';
    speakBtn.innerHTML = '<span>🔊</span><span>Speak</span>';
    speakBtn.onclick = () => {
      speakBtn.classList.add('done');
      speakBtn.innerHTML = '<span>🎵</span><span>Playing</span>';
      speak(text);
      setTimeout(() => {
        speakBtn.classList.remove('done');
        speakBtn.innerHTML = '<span>🔊</span><span>Speak</span>';
      }, 2000);
    };
    meta.appendChild(speakBtn);

    const retryBtn = document.createElement('button');
    retryBtn.type = 'button'; retryBtn.className = 'msg-action';
    retryBtn.innerHTML = '<span>↻</span><span>Retry</span>';
    retryBtn.onclick = retryLast;
    meta.appendChild(retryBtn);

    if (tokens) {
      const ti = document.createElement('span');
      ti.textContent = '• ' + tokens + ' tokens';
      ti.style.marginLeft = '0.3rem';
      ti.style.fontSize = '0.7rem';
      meta.appendChild(ti);
    }
    return meta;
  }

