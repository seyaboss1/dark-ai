<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DARK AI — دردشة ذكاء اصطناعي عربي / إنجليزي / أمهري</title>
<meta name="description" content="DARK AI: مساعد ذكاء اصطناعي مجاني للمحادثة، الصور، الفيديو والكود." />
<meta name="keywords" content="ذكاء اصطناعي,AI chat,Arabic AI,Amharic AI,dark ai" />
<meta name="google-site-verification" content="wD2Re2jxMSxOV7M00szT88G2ckNg4nEUKXm4uLrcADU" />
<meta property="og:title" content="DARK AI - Chat, Create & Code" />
<meta property="og:description" content="Multilingual AI assistant." />
<meta property="og:url" content="https://dark-ai-306y.onrender.com/" />
<meta property="og:type" content="website" />
<meta property="og:image" content="https://dark-ai-306y.onrender.com/logo.png" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="apple-touch-icon" href="/logo.png" />
<link rel="stylesheet" href="styles.css" />
<script src="https://js.puter.com/v2/"></script>
</head>
<body>

<div class="bg-layer" aria-hidden="true">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <div class="grid-overlay"></div>
</div>

<header>
  <div class="nav">
    <div class="nav-left">
      <button class="icon-tool" id="sidebarToggle" title="Toggle sidebar" type="button" aria-label="Sidebar">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <a href="index.html" class="brand">
        <div class="brand-mark">◆</div>
        <span class="brand-text">DARK</span>
      </a>
    </div>
    <div class="nav-actions">
      <div class="auth-badge" id="authBadge" style="display:none">
        <span class="avatar-sm" id="authAvatar">U</span>
        <span id="authName">User</span>
      </div>
      <button class="icon-tool" id="btnSettings" title="Settings" type="button">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="layout">
  <aside class="sidebar" id="sidebar">
    <div class="user-card" id="userCard" style="display:none">
      <div class="avatar-lg" id="userAvatar">U</div>
      <div class="info">
        <div class="name" id="userName">User</div>
        <div class="sub" id="userSub">Signed in</div>
      </div>
      <span class="crown" id="userCrown" style="display:none">👑</span>
    </div>
    <button class="new-chat" id="newChat" type="button">＋ New Chat</button>
    <input type="text" class="search-box" id="searchBox" placeholder="Search chats…" />
    <div class="chat-list" id="chatList"></div>
    <div class="sidebar-footer">
      <button class="sidebar-btn super" id="superBtn" type="button" style="display:none">👑 SUPER ADMIN</button>
      <button class="sidebar-btn" id="exportAllBtn" type="button">⬇ Export all</button>
      <button class="sidebar-btn" id="clearAllBtn" type="button">🗑 Clear all</button>
    </div>
  </aside>

  <div class="chat-area">
    <div class="chat-wrap">
      <div class="chat-head">
        <div class="status-dot"></div>
        <div class="chat-head-title">
          <b>DARK AI</b>
          <small id="chatStatus">Connecting…</small>
        </div>
        <button class="icon-tool" id="voiceBtn" title="Voice input" type="button">
          <svg viewBox="0 0 24 24"><path d="M12 2a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1"/><line x1="12" y1="18" x2="12" y2="22"/></svg>
        </button>
      </div>

      <div class="chat-body" id="chatBody"></div>

      <div class="chat-input">
        <input id="chatInput" type="text" placeholder="Type, speak, or ask for anything…" autocomplete="off" />
        <button class="send-btn" id="sendBtn" type="button">SEND</button>
      </div>
    </div>
  </div>
</div>

<!-- SETTINGS MODAL -->
<div class="modal-bg" id="settingsModal">
  <div class="modal">
    <h2>⚙ SETTINGS</h2>
    <h3>👤 Account</h3>
    <div id="authBox" class="auth-box"></div>
    <label>Preferred Reply Language</label>
    <div class="lang-grid" id="langGrid"></div>
    <label>Image Size</label>
    <div class="size-grid" id="sizeGrid"></div>
    <h3>Voice & Audio</h3>
    <div class="voice-row">
      <div class="toggle" id="autoSpeakToggle"></div>
      <span>Auto-speak AI replies</span>
    </div>
    <h3>Appearance</h3>
    <div class="voice-row">
      <div class="toggle" id="themeToggle"></div>
      <span>Dark mode</span>
    </div>
    <div class="modal-actions">
      <button class="cancel" id="settingsCancel" type="button">Cancel</button>
      <button class="save" id="settingsSave" type="button">Save</button>
    </div>
  </div>
</div>

<!-- PROFILE MODAL -->
<div class="modal-bg" id="profileModal">
  <div class="modal">
    <h2>👤 PROFILE</h2>
    <div class="profile-header">
      <div class="profile-avatar" id="profileAvatar">U</div>
      <div class="profile-info">
        <div class="profile-name" id="profileName">User</div>
        <div class="profile-email" id="profileEmail">—</div>
        <div class="profile-role" id="profileRole" style="display:none">👑 SUPER ADMIN</div>
      </div>
    </div>
    <div class="stats-grid" id="profileStats"></div>
    <div class="modal-actions">
      <button class="cancel" id="profileClose" type="button">Close</button>
    </div>
  </div>
</div>

<!-- AD EDITOR MODAL -->
<div class="modal-bg" id="adEditModal">
  <div class="modal">
    <h2 id="adEditTitle">📢 NEW AD</h2>
    <label>Title</label>
    <input type="text" id="adTitle" placeholder="Special Offer!" />
    <label>Description</label>
    <textarea id="adDesc" placeholder="Visit our store…"></textarea>
    <label>Image URL (optional)</label>
    <input type="text" id="adImage" placeholder="https://…" />
    <label>CTA Link</label>
    <input type="text" id="adLink" placeholder="https://…" />
    <label>CTA Text</label>
    <input type="text" id="adCta" placeholder="Learn More" />
    <label>Show every N messages</label>
    <input type="number" id="adFreq" value="10" min="1" />
    <div class="modal-actions">
      <button class="cancel" id="adEditCancel" type="button">Cancel</button>
      <button class="save" id="adEditSave" type="button">Save</button>
    </div>
  </div>
</div>

<!-- FULLSCREEN AD -->
<div class="ad-fullscreen" id="adFullscreen">
  <div class="ad-content">
    <div class="ad-badge">SPONSORED</div>
    <button class="ad-skip" id="adSkip" disabled>5</button>
    <img class="ad-image" id="adFsImage" src="" alt="" style="display:none" />
    <h2 class="ad-title" id="adFsTitle">Special Offer</h2>
    <p class="ad-desc" id="adFsDesc">Check out this deal!</p>
    <a class="ad-cta" id="adFsCta" href="#" target="_blank" rel="noopener">Learn More</a>
  </div>
</div>

<!-- SUPER ADMIN PANEL -->
<div class="super-panel" id="superPanel">
  <div class="super-header">
    <div class="super-title">👑 SUPER ADMIN</div>
    <div class="super-badge">SYSTEM OWNER</div>
    <button class="super-tool danger" id="superClose" type="button">✕ Close</button>
  </div>

  <div class="super-grid">
    <div class="super-card">
      <h3>📊 Live Statistics</h3>
      <p>Real-time platform metrics</p>
      <div class="value" id="saTotalUsers">1</div>
      <div class="sa-label" id="saMsgDetail">TOTAL USERS</div>
      <div class="super-row">
        <button class="super-btn" id="saRefreshStats" type="button">🔄 Refresh</button>
        <button class="super-btn warn" id="saResetStats" type="button">↻ Reset</button>
      </div>
    </div>
    <div class="super-card">
      <h3>💬 Chat Activity</h3>
      <p>Total messages and chats</p>
      <div class="value" id="saTotalChats">0</div>
      <div class="sa-label">ACTIVE CHATS</div>
      <div class="super-row">
        <button class="super-btn" id="saViewChats" type="button">👁 View All</button>
      </div>
    </div>
    <div class="super-card">
      <h3>📢 Advertisements</h3>
      <p>Manage ads shown to all users</p>
      <div class="value" id="saTotalAds">0</div>
      <div class="sa-label">ACTIVE ADS</div>
      <div class="super-row">
        <button class="super-btn" id="saAddAd" type="button">＋ Add Ad</button>
        <button class="super-btn" id="saManageAds" type="button">📋 Manage</button>
      </div>
    </div>
    <div class="super-card">
      <h3>🧠 System Prompt</h3>
      <p>Edit DARK's personality</p>
      <div class="super-row">
        <button class="super-btn" id="saEditPrompt" type="button">✏️ Edit Prompt</button>
        <button class="super-btn warn" id="saResetPrompt" type="button">↻ Reset</button>
      </div>
    </div>
    <div class="super-card">
      <h3>💾 Data Management</h3>
      <p>Backup, restore, and reset</p>
      <div class="super-row">
        <button class="super-btn" id="saExportAll" type="button">⬇ Export All</button>
        <button class="super-btn" id="saImportAll" type="button">⬆ Import</button>
        <button class="super-btn danger" id="saClearEverything" type="button">🗑 Wipe All</button>
      </div>
    </div>
    <div class="super-card">
      <h3>👥 User Management</h3>
      <p>Manage platform access</p>
      <div class="super-row">
        <button class="super-btn" id="saListUsers" type="button">👁 List Users</button>
        <button class="super-btn warn" id="saClearUsers" type="button">↻ Clear Log</button>
      </div>
    </div>
    <div class="super-card">
      <h3>🎨 Branding</h3>
      <p>Customize platform identity</p>
      <div class="super-row">
        <button class="super-btn" id="saChangeColors" type="button">🎨 Colors</button>
        <button class="super-btn" id="saChangeLogo" type="button">◆ Logo</button>
      </div>
    </div>
    <div class="super-card">
      <h3>📝 Custom Pages</h3>
      <p>Add pages accessible to all users</p>
      <div class="super-row">
        <button class="super-btn" id="saAddPage" type="button">＋ Add Page</button>
        <button class="super-btn" id="saListPages" type="button">📋 List Pages</button>
      </div>
    </div>
    <div class="super-card">
      <h3>⚡ Quick Actions</h3>
      <p>Fast maintenance tasks</p>
      <div class="super-row">
        <button class="super-btn" id="saReload" type="button">🔄 Reload Site</button>
        <button class="super-btn warn" id="saToggleTheme" type="button">🌗 Toggle Theme</button>
      </div>
    </div>
    <div class="super-card danger-card">
      <h3>⚠️ Danger Zone</h3>
      <p>Irreversible operations</p>
      <div class="super-row">
        <button class="super-btn danger" id="saFactoryReset" type="button">💥 Factory Reset</button>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="config.js"></script>
<script src="app.js"></script>
<script src="admin.js"></script>
</body>
</html>
