  function updateRecTime() {
    const m = Math.floor(recSeconds / 60);
    const s = recSeconds % 60;
    $('recTime').textContent = m + ':' + String(s).padStart(2, '0');
  }

  async function startVoiceMode() {
    if (voiceModeActive) return;
    if (!window.isSecureContext) {
      toast('⚠️ Mic needs HTTPS or localhost.');
      return;
    }
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      toast('⚠️ Microphone not supported.');
      return;
    }
    try {
      audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      voiceModeActive = true;
      $('micBtn').classList.add('recording');
      $('chatInputWrap').classList.add('recording');
      $('recOverlay').classList.add('show');
      $('recHint').textContent = 'Listening… (auto-send on silence)';
      await startRecordingCycle();
      startSilenceDetection();
    } catch (err) {
      let msg = '⚠️ ';
      if (err.name === 'NotAllowedError') msg += 'Permission denied.';
      else if (err.name === 'NotFoundError') msg += 'No microphone found.';
      else if (err.name === 'NotReadableError') msg += 'Mic busy.';
      else msg += err.message;
      toast(msg);
      voiceModeActive = false;
    }
  }

  async function startRecordingCycle() {
    if (!voiceModeActive) return;
    if (mediaRecorder && mediaRecorder.state === 'recording') return;
    recordedChunks = [];
    try {
      const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
        ? 'audio/webm;codecs=opus'
        : (MediaRecorder.isTypeSupported('audio/mp4') ? 'audio/mp4' : '');
      mediaRecorder = mimeType
        ? new MediaRecorder(audioStream, { mimeType })
        : new MediaRecorder(audioStream);
      mediaRecorder.ondataavailable = e => { if (e.data.size > 0) recordedChunks.push(e.data); };
      mediaRecorder.onstop = onRecordingStopped;
      mediaRecorder.start(100);
      recSeconds = 0; updateRecTime();
      clearInterval(recTimerInterval);
      recTimerInterval = setInterval(() => {
        recSeconds++; updateRecTime();
        if (recSeconds >= 30 && mediaRecorder && mediaRecorder.state === 'recording') {
          mediaRecorder.stop();
        }
      }, 1000);
    } catch (err) {
      toast('Recording error: ' + err.message);
      voiceModeActive = false;
    }
  }

  function startSilenceDetection() {
    try {
      audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const source = audioContext.createMediaStreamSource(audioStream);
      analyser = audioContext.createAnalyser();
      analyser.fftSize = 512;
      analyser.smoothingTimeConstant = 0.8;
      source.connect(analyser);
      const dataArray = new Uint8Array(analyser.fftSize);
      let silenceStart = null;
      const SILENCE_THRESHOLD = 15;
      const SILENCE_DURATION = 2500;
      clearInterval(silenceCheckInterval);
      silenceCheckInterval = setInterval(() => {
        if (!voiceModeActive || !analyser) return;
        analyser.getByteFrequencyData(dataArray);
        let sum = 0;
        for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
        const avg = sum / dataArray.length;
        updateWaveformBars(avg);
        if (avg < SILENCE_THRESHOLD) {
          if (!silenceStart) silenceStart = Date.now();
          const elapsed = Date.now() - silenceStart;
          if (elapsed > SILENCE_DURATION && mediaRecorder && mediaRecorder.state === 'recording') {
            if (recSeconds >= 1) mediaRecorder.stop();
            else silenceStart = null;
          }
        } else silenceStart = null;
      }, 100);
    } catch (err) { console.warn('Silence detection failed:', err); }
  }

  function updateWaveformBars(level) {
    const bars = document.querySelectorAll('#waveform .bar');
    const scale = Math.min(level / 60, 1.5);
    bars.forEach(bar => {
      const h = Math.max(15, scale * 100 * (0.7 + Math.random() * 0.6));
      bar.style.height = h + '%';
    });
  }

  function stopVoiceMode() {
    voiceModeActive = false;
    if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
    clearInterval(recTimerInterval);
    clearInterval(silenceCheckInterval);
    if (audioContext) { audioContext.close().catch(() => {}); audioContext = null; }
    analyser = null;
    if (audioStream) { audioStream.getTracks().forEach(t => t.stop()); audioStream = null; }
    $('micBtn').classList.remove('recording');
    $('chatInputWrap').classList.remove('recording');
    $('recOverlay').classList.remove('show');
  }

  async function onRecordingStopped() {
    clearInterval(recTimerInterval);
    if (!recordedChunks.length) {
      if (voiceModeActive) startRecordingCycle();
      return;
    }
    const blob = new Blob(recordedChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
    recordedChunks = [];
    $('recHint').textContent = 'Transcribing…';
    $('recTranscript').textContent = '';
    setStatus('Transcribing…');
    try {
      const fd = new FormData();
      fd.append('file', blob, 'audio.webm');
      fd.append('model', 'whisper-large-v3');
      if (preferredLang !== 'auto') fd.append('language', preferredLang);
      const res = await fetch(WHISPER_URL, { method: 'POST', body: fd });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      if (data.error) throw new Error(data.error.message || data.error);
      const text = (data.text || '').trim();
      if (text.length < 2) {
        if (voiceModeActive) { $('recHint').textContent = 'Listening…'; startRecordingCycle(); }
        return;
      }
      $('recTranscript').textContent = '"' + text + '"';
      $('recHint').textContent = 'Sending…';
      setStatus('Sending…');
      $('chatInput').value = text;
      await sendMsg();
      if (voiceModeActive) {
        setTimeout(() => {
          $('recHint').textContent = 'Listening…';
          $('recTranscript').textContent = '';
          startRecordingCycle();
        }, 800);
      } else stopVoiceMode();
    } catch (err) {
      toast('Transcription failed: ' + err.message);
      setStatus('Error', false);
      if (voiceModeActive) setTimeout(() => startRecordingCycle(), 1000);
    }
  }

  function getImageDimensions() {
    const s = IMAGE_SIZES.find(x => x.code === preferredSize) || IMAGE_SIZES[0];
    return { w: s.w, h: s.h };
  }

  async function generateImage(userPrompt, opts = {}) {
    const t = threads[activeId];
    if (!t) return;
    const isHD = opts.hd === true;
    const isFaceFix = opts.faceFix === true;

    busy = true;
    $('sendBtn').disabled = true;
    $('btnImage').disabled = true;
    $('btnVideo').disabled = true;

    const prefix = isFaceFix ? '👤 Face Enhance: ' : (isHD ? '💎 HD: ' : '🎨 ');
    renderUserMsg(prefix + userPrompt);
    $('chatInput').value = '';

    let prompt = enhancePrompt(userPrompt, 'image');
    if (isFaceFix) {
      prompt += ', ultra detailed face, perfect symmetrical features, natural skin texture, hyperrealistic portrait, 8k face detail, professional beauty photography';
    }

    t.messages.push({ role: 'user', content: '[Image request] ' + prompt });
    saveThreads();

    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row ai';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const wrap = document.createElement('div');
    wrap.className = 'msg ai msg-image';
    wrap.innerHTML = '<div class="img-progress"><div class="spinner"></div><span>' +
      (isFaceFix ? 'Enhancing face…' : isHD ? 'Rendering HD…' : 'Generating…') + '</span></div>';
    col.appendChild(wrap); row.appendChild(col);
    $('chatBody').appendChild(row); scrollBottom();
    setStatus(isFaceFix ? 'Enhancing face…' : isHD ? 'Rendering HD…' : 'Generating image…');

    try {
      const seed = Math.floor(Math.random() * 1000000);
      let w, h;
      if (isHD) { w = 2048; h = 2048; }
      else { const d = getImageDimensions(); w = d.w; h = d.h; }

      const model = isFaceFix ? 'flux-realism' : (isHD ? 'flux' : preferredQuality);
      const encoded = encodeURIComponent(prompt);
      const neg = encodeURIComponent(buildNegativePrompt());

      const url = `https://image.pollinations.ai/prompt/${encoded}?width=${w}&height=${h}&seed=${seed}&model=${model}&enhance=true&safe=false&private=true&nologo=true&negative=${neg}`;

      const loaded = await new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = url;
        setTimeout(() => resolve(false), isHD || isFaceFix ? 120000 : 90000);
      });

      if (!loaded) throw new Error('Timeout');

      wrap.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = prompt;
      img.onclick = () => window.open(url, '_blank');
      wrap.appendChild(img);

      const meta = document.createElement('div');
      meta.className = 'msg-meta';
      meta.style.opacity = '1';

      const hdBtn = document.createElement('button');
      hdBtn.type = 'button'; hdBtn.className = 'msg-action hd';
      hdBtn.innerHTML = '<span>💎</span><span>HD 2048</span>';
      hdBtn.onclick = () => generateImage(userPrompt, { hd: true });
      meta.appendChild(hdBtn);

      const faceBtn = document.createElement('button');
      faceBtn.type = 'button'; faceBtn.className = 'msg-action face-enhance';
      faceBtn.innerHTML = '<span>👤</span><span>Face Enhance</span>';
      faceBtn.onclick = () => generateImage(userPrompt, { faceFix: true });
      meta.appendChild(faceBtn);

      const dlBtn = document.createElement('button');
      dlBtn.type = 'button'; dlBtn.className = 'msg-action';
      dlBtn.innerHTML = '<span>⬇</span><span>Download</span>';
      dlBtn.onclick = async () => {
        try {
          const res = await fetch(url);
          const blob = await res.blob();
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'dark-pro-' + Date.now() + '.png';
          a.click();
          toast('Downloaded');
        } catch (e) { window.open(url, '_blank'); }
      };
      meta.appendChild(dlBtn);

      const reBtn = document.createElement('button');
      reBtn.type = 'button'; reBtn.className = 'msg-action';
      reBtn.innerHTML = '<span>🔄</span><span>Regenerate</span>';
      reBtn.onclick = () => generateImage(userPrompt, opts);
      meta.appendChild(reBtn);

      col.appendChild(meta);

      t.messages.push({
        role: 'assistant',
        content: '[Generated image]: ' + prompt + '\n![image](' + url + ')'
      });
      saveThreads();
      setStatus('Online • image ready');
      toast('Image ready');

    } catch (err) {
      wrap.innerHTML = '<div class="img-progress" style="color:var(--err)">⚠️ Failed. ' +
        '<button class="msg-action" onclick="retryImage(\'' + userPrompt.replace(/'/g, "\\'") + '\')" style="color:var(--accent); margin-left: 0.5rem;">↻ Try again</button></div>';
      setStatus('Image error', false);
      toast('Image failed');
    } finally {
      busy = false;
      $('sendBtn').disabled = false;
      $('btnImage').disabled = false;
      $('btnVideo').disabled = false;
      $('chatInput').focus();
    }
  }

  window.retryImage = function(prompt) { generateImage(prompt); };

  async function generateVideo(userPrompt) {
    const t = threads[activeId];
    if (!t) return;

    busy = true;
    $('sendBtn').disabled = true;
    $('btnImage').disabled = true;
    $('btnVideo').disabled = true;

    renderUserMsg('🎬 ' + userPrompt);
    $('chatInput').value = '';

    const prompt = enhancePrompt(userPrompt, 'video');
    t.messages.push({ role: 'user', content: '[Video request] ' + prompt });
    saveThreads();

    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row ai';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const wrap = document.createElement('div');
    wrap.className = 'msg ai msg-video';
    wrap.innerHTML = '<div class="img-progress"><div class="spinner"></div><span>Generating video… (30-60s)</span></div>';
    col.appendChild(wrap); row.appendChild(col);
    $('chatBody').appendChild(row); scrollBottom();
    setStatus('Generating video…');

    try {
      const seed = Math.floor(Math.random() * 1000000);
      const encoded = encodeURIComponent(prompt);
      const url = `https://image.pollinations.ai/prompt/${encoded}?width=1280&height=720&seed=${seed}&model=flux&nologo=true&enhance=true`;

      const loaded = await new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = url;
        setTimeout(() => resolve(false), 90000);
      });

      if (!loaded) throw new Error('Timeout');

      wrap.innerHTML = '';
      const img = document.createElement('img');
      img.src = url;
      img.alt = prompt;
      img.onclick = () => window.open(url, '_blank');
      wrap.appendChild(img);

      const meta = document.createElement('div');
      meta.className = 'msg-meta';
      meta.style.opacity = '1';

      const dlBtn = document.createElement('button');
      dlBtn.type = 'button'; dlBtn.className = 'msg-action';
      dlBtn.innerHTML = '<span>⬇</span><span>Download</span>';
      dlBtn.onclick = async () => {
        try {
          const res = await fetch(url);
          const blob = await res.blob();
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'dark-video-' + Date.now() + '.jpg';
          a.click();
          toast('Downloaded');
        } catch (e) { window.open(url, '_blank'); }
      };
      meta.appendChild(dlBtn);

      const reBtn = document.createElement('button');
      reBtn.type = 'button'; reBtn.className = 'msg-action';
      reBtn.innerHTML = '<span>🔄</span><span>Regenerate</span>';
      reBtn.onclick = () => generateVideo(userPrompt);
      meta.appendChild(reBtn);

      const info = document.createElement('span');
      info.innerHTML = '<span style="background:linear-gradient(135deg,var(--accent),var(--accent-2));color:white;padding:0.15rem 0.5rem;border-radius:999px;font-size:0.65rem;font-weight:800;">ANIMATED</span>';
      meta.appendChild(info);

      col.appendChild(meta);

      t.messages.push({
        role: 'assistant',
        content: '[Generated video]: ' + prompt + '\n![video](' + url + ')'
      });
      saveThreads();
      setStatus('Online • video ready');
      toast('Video ready');

    } catch (err) {
      wrap.innerHTML = '<div class="img-progress" style="color:var(--err)">⚠️ ' + err.message +
        ' <button class="msg-action" onclick="retryVideo(\'' + userPrompt.replace(/'/g, "\\'") + '\')" style="color:var(--accent); margin-left: 0.5rem;">↻ Try</button></div>';
      setStatus('Video error', false);
      toast('Video failed');
    } finally {
      busy = false;
      $('sendBtn').disabled = false;
      $('btnImage').disabled = false;
      $('btnVideo').disabled = false;
      $('chatInput').focus();
    }
  }

  window.retryVideo = function(prompt) { generateVideo(prompt); };

  async function sendMsg() {
    if (busy) return;
    const text = $('chatInput').value.trim();
    if (!text) return;
    const t = threads[activeId];
    if (!t) return;

    const vidPrompt = detectVideoIntent(text);
    if (vidPrompt) {
      $('chatInput').value = '';
      await generateVideo(vidPrompt);
      return;
    }
    const imgPrompt = detectImageIntent(text);
    if (imgPrompt) {
      $('chatInput').value = '';
      await generateImage(imgPrompt);
      return;
    }
    if (t.messages.filter(m => m.role === 'user').length === 0) {
      t.title = text.length > 40 ? text.slice(0, 40) + '…' : text;
      renderThreads();
    }
    renderUserMsg(text);
    $('chatInput').value = '';
    t.messages.push({ role: 'user', content: text });
    await saveThreads();
    await streamReply();
    messageCounter++;
    localStorage.setItem('dark-msg-counter', messageCounter);
    checkAndShowAd();
  }

  async function streamReply() {
    const t = threads[activeId];
    if (!t) return;
    busy = true;
    $('sendBtn').disabled = true;
    $('sendBtn').textContent = 'STOP';
    $('sendBtn').classList.add('stop');
    const typing = renderTyping();
    setStatus('Thinking…');
    abortController = new AbortController();
    try {
      const res = await fetch(PROXY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: t.messages.slice(-20) }),
        signal: abortController.signal
      });
      const data = await res.json();
      typing.remove();
      if (!res.ok || data.error) {
        renderAiMsg('⚠️ Error: ' + (data.error?.message || data.error || ('HTTP ' + res.status)));
        setStatus('Error', false); return;
      }
      const reply = data.choices?.[0]?.message?.content?.trim() || '(empty response)';
      const tokens = data.usage?.total_tokens;
      t.messages.push({ role: 'assistant', content: reply });
      await saveThreads();
      await typewriterRender(reply, tokens);
      setStatus(tokens ? 'Online • ' + tokens + ' tokens' : 'Online');
      if (autoSpeak) speak(reply);
    } catch (err) {
      typing.remove();
      if (err.name === 'AbortError') { renderAiMsg('(stopped)'); setStatus('Stopped'); }
      else { renderAiMsg('⚠️ Connection error. Proxy on port 1400?'); setStatus('Offline', false); }
    } finally {
      busy = false; abortController = null;
      $('sendBtn').disabled = false;
      $('sendBtn').textContent = 'SEND';
      $('sendBtn').classList.remove('stop');
      $('chatInput').focus();
    }
  }

  async function typewriterRender(fullText, tokens) {
    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row ai';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const m = document.createElement('div');
    m.className = 'msg ai';
    const cursor = document.createElement('span');
    cursor.className = 'cursor';
    m.appendChild(cursor);
    col.appendChild(m); row.appendChild(col); $('chatBody').appendChild(row);
    const speed = fullText.length > 500 ? 3 : fullText.length > 200 ? 6 : 10;
    for (let i = 0; i < fullText.length; i++) {
      m.innerHTML = renderMarkdown(fullText.slice(0, i + 1));
      m.appendChild(cursor);
      scrollBottom();
      await new Promise(r => setTimeout(r, speed));
    }
    cursor.remove();
    m.innerHTML = renderMarkdown(fullText);
    col.appendChild(buildMeta(fullText, tokens));
    scrollBottom();
  }

  async function retryLast() {
    if (busy) return;
    const t = threads[activeId];
    if (!t) return;
    while (t.messages.length > 1 && t.messages[t.messages.length - 1].role === 'assistant') {
      t.messages.pop();
    }
    await saveThreads();
    rebuildUI();
    if (t.messages.length > 1) await streamReply();
    else toast('Nothing to retry');
  }

  function rebuildUI() {
    $('chatBody').innerHTML = '';
    const t = threads[activeId];
    if (!t) return;
    const visible = t.messages.filter(m => m.role !== 'system');
    if (visible.length === 0) {
      const w = document.createElement('div');
      w.className = 'welcome'; w.id = 'welcome';
      w.innerHTML =
        '<div class="welcome-icon">◆</div>' +
        '<h1>Chat, speak, <span class="grad">create HD anything</span>.</h1>' +
        '<p>Arabic, English, Amharic & more. Professional images and videos with face enhancement.</p>' +
        '<div class="quick-grid" id="quickGrid"></div>';
      $('chatBody').appendChild(w);
      buildQuickGrid(w.querySelector('#quickGrid'));
      return;
    }
    visible.forEach(m => {
      if (m.role === 'user') {
        renderUserMsg(typeof m.content === 'string' ? m.content : '[message]');
      } else {
        const text = typeof m.content === 'string' ? m.content : '';
        const vidMatch = text.match(/!\[video\]\((https?:\/\/[^\)]+|blob:[^\)]+)\)/);
        const imgMatch = text.match(/!\[image\]\((https?:\/\/[^\)]+)\)/);
        if (vidMatch) renderVideoFromHistory(vidMatch[1]);
        else if (imgMatch) renderImageFromHistory(imgMatch[1]);
        else renderAiMsg(text);
      }
    });
    scrollBottom();
  }

  function renderVideoFromHistory(url) {
    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row ai';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const wrap = document.createElement('div');
    wrap.className = 'msg ai msg-video';
    const img = document.createElement('img');
    img.src = url;
    wrap.appendChild(img);
    col.appendChild(wrap); row.appendChild(col);
    $('chatBody').appendChild(row); scrollBottom();
  }

  function renderImageFromHistory(url) {
    hideWelcome();
    const row = document.createElement('div');
    row.className = 'msg-row ai';
    const col = document.createElement('div');
    col.className = 'msg-col';
    const wrap = document.createElement('div');
    wrap.className = 'msg ai msg-image';
    const img = document.createElement('img');
    img.src = url;
    img.onclick = () => window.open(url, '_blank');
    wrap.appendChild(img);
    col.appendChild(wrap); row.appendChild(col);
    $('chatBody').appendChild(row); scrollBottom();
  }

  function renderAuthBox() {
    const box = $('authBox');
    if (currentUser) {
      const name = currentUser.username || currentUser.email || 'User';
      const email = currentUser.email || currentUser.username || '';
      box.innerHTML =
        '<div class="signed-info">✓ Signed in as <br><b>' + escapeHtml(name) + '</b><br>' +
        '<small style="font-size:0.72rem;color:var(--muted);font-weight:400">' + escapeHtml(email) + '</small>' +
        (isAdmin ? '<br><span style="color:var(--gold);font-size:0.72rem">👑 ADMIN MODE</span>' : '') +
        '</div>' +
        '<button class="logout" id="settingsSignOut">🚪 Sign Out</button>';
      setTimeout(() => {
        const btn = $('settingsSignOut');
        if (btn) btn.onclick = handleSignOut;
      }, 0);
    } else {
      box.innerHTML =
        '<p>Sign in to sync your chats across devices.</p>' +
        '<button id="settingsSignIn">👤 Sign In with Puter</button>';
      setTimeout(() => {
        const btn = $('settingsSignIn');
        if (btn) btn.onclick = handleSignIn;
      }, 0);
    }
  }

  async function updateAuthUI() {
  // Track user
try { trackUser(name); } catch(e) {}  try {
      const signed = await puter.auth.isSignedIn();
      if (signed) {
        currentUser = await puter.auth.getUser();
        const name = currentUser.username || currentUser.email || 'User';
        const email = currentUser.email || '';
        const _email = (email || '').toLowerCase();
const _name = (name || '').toLowerCase();
isAdmin = ADMIN_USERS.some(function(u) {
  const lu = u.toLowerCase();
  return _email === lu || _name === lu;
});

        const badge = $('authBadge');
        badge.style.display = 'flex';
        badge.classList.toggle('admin', isAdmin);
        $('authAvatar').textContent = name.charAt(0).toUpperCase();
        $('authName').textContent = name;

        $('userCard').style.display = 'flex';
        $('userName').textContent = name;
        $('userSub').textContent = email;
        $('userAvatar').textContent = name.charAt(0).toUpperCase();
        $('userCrown').style.display = isAdmin ? 'inline' : 'none';
        $('adminBtn').style.display = isAdmin ? 'flex' : 'none';

        const pa = $('profileAvatar');
        pa.textContent = name.charAt(0).toUpperCase();
        pa.className = 'profile-avatar' + (isAdmin ? ' admin' : '');
      } else {
        currentUser = null;
        isAdmin = false;
        $('authBadge').style.display = 'none';
        $('userCard').style.display = 'none';
        $('adminBtn').style.display = 'none';
      }
      renderAuthBox();
    } catch (e) { console.warn('Auth check failed:', e); }
  }

  async function handleSignIn() {
    try {
      await puter.auth.signIn();
      const user = await puter.auth.getUser();
      toast('Welcome, ' + (user.username || 'User'));
      await updateAuthUI();
      renderThreads(); rebuildUI();
    } catch (err) {
      toast('Auth error: ' + (err.message || 'unknown'));
    }
  }

  async function handleSignOut() {
    if (!confirm('Sign out?')) return;
    try {
      await puter.auth.signOut();
      currentUser = null; isAdmin = false;
      await updateAuthUI();
      toast('Signed out');
    } catch (e) { toast('Sign out failed'); }
  }

  function openProfile() {
    if (!currentUser) return;
    const name = currentUser.username || currentUser.email || 'User';
    const email = currentUser.email || '—';
    $('profileName').textContent = name;
    $('profileEmail').textContent = email;
    $('profileAvatar').textContent = name.charAt(0).toUpperCase();
    $('profileRole').style.display = isAdmin ? 'inline-flex' : 'none';
    const statsEl = $('profileStats');
    statsEl.innerHTML = '';
    const myChats = Object.keys(threads).length;
    const myMessages = Object.values(threads).reduce((sum, t) =>
      sum + t.messages.filter(m => m.role !== 'system').length, 0);
    addStatCard(statsEl, myChats, 'Your Chats');
    addStatCard(statsEl, myMessages, 'Your Messages');
    if (isAdmin) {
      const totalUsers = parseInt(localStorage.getItem('dark-total-users') || '1');
      addStatCard(statsEl, totalUsers, 'Total Users');
      addStatCard(statsEl, ads.length, 'Active Ads');
    }
    $('profileModal').classList.add('show');
  }

  function addStatCard(container, value, label) {
    const card = document.createElement('div');
    card.className = 'stat-card';
    card.innerHTML = '<div class="stat-value">' + value + '</div>' +
                     '<div class="stat-label">' + label + '</div>';
    container.appendChild(card);
  }

  /* ============================================================
   ADMIN EXTRA FEATURES
   ============================================================ */
function viewSite() {
  window.open(location.origin, '_blank');
}

function exportAllData() {
  const data = {
    threads: threads,
    ads: ads,
    settings: {
      lang: preferredLang,
      size: preferredSize,
      quality: preferredQuality,
      theme: theme,
      autoSpeak: autoSpeak
    },
    exportDate: new Date().toISOString()
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'dark-ai-backup-' + Date.now() + '.json';
  a.click();
  toast('✅ Data exported');
}

function importData() {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json';
  input.onchange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const data = JSON.parse(ev.target.result);
        if (data.threads) {
          threads = data.threads;
          localStorage.setItem('dark-threads', JSON.stringify(threads));
        }
        if (data.ads) {
          ads = data.ads;
          localStorage.setItem('dark-ads', JSON.stringify(ads));
        }
        if (data.settings) {
          if (data.settings.lang) preferredLang = data.settings.lang;
          if (data.settings.size) preferredSize = data.settings.size;
          if (data.settings.quality) preferredQuality = data.settings.quality;
          if (data.settings.theme) {
            theme = data.settings.theme;
            applyTheme();
          }
        }
        renderThreads();
        rebuildUI();
        toast('✅ Data imported successfully');
      } catch (err) {
        toast('❌ Invalid file: ' + err.message);
      }
    };
    reader.readAsText(file);
  };
  input.click();
}

function resetStats() {
  if (!confirm('Reset all statistics?')) return;
  localStorage.removeItem('dark-msg-counter');
  localStorage.setItem('dark-total-users', '1');
  messageCounter = 0;
  toast('✅ Statistics reset');
  openAdmin();
}

function renderRecentUsers() {
  const list = $('recentUsersList');
  if (!list) return;
  const users = JSON.parse(localStorage.getItem('dark-recent-users') || '[]');
  if (users.length === 0) {
    list.innerHTML = '<p style="color:var(--muted);text-align:center;">No users tracked yet</p>';
    return;
  }
  list.innerHTML = users.slice(-10).reverse().map(u => `
    <div style="display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid var(--border);">
      <span>${escapeHtml(u.name || 'Anonymous')}</span>
      <span style="color:var(--muted);font-size:0.75rem;">${new Date(u.time).toLocaleDateString()}</span>
    </div>
  `).join('');
}

function trackUser(name) {
  const users = JSON.parse(localStorage.getItem('dark-recent-users') || '[]');
  users.push({ name, time: Date.now() });
  localStorage.setItem('dark-recent-users', JSON.stringify(users.slice(-50)));
}function openAdmin() {
    if (!isAdmin) return;
    const statsEl = $('adminStats');
    statsEl.innerHTML = '';
    const totalUsers = parseInt(localStorage.getItem('dark-total-users') || '1');
    const totalChats = Object.keys(threads).length;
    const totalMessages = Object.values(threads).reduce((sum, t) =>
      sum + t.messages.filter(m => m.role !== 'system').length, 0);
    addStatCard(statsEl, totalUsers, 'Total Users');
    addStatCard(statsEl, totalChats, 'Total Chats');
    addStatCard(statsEl, totalMessages, 'Messages');
    addStatCard(statsEl, ads.length, 'Active Ads');
    renderAdList();
    $('adminModal').classList.add('show');
  }

  function renderAdList() {
    const list = $('adList');
    list.innerHTML = '';
    if (ads.length === 0) {
      list.innerHTML = '<p style="color:var(--muted); font-size:0.85rem; text-align:center; padding:1rem;">No ads yet.</p>';
      return;
    }
    ads.forEach((ad, i) => {
      const item = document.createElement('div');
      item.className = 'ad-item';
      item.innerHTML =
        '<div class="ad-item-header">' +
          '<div class="ad-item-title">' + escapeHtml(ad.title || 'Untitled') + '</div>' +
          '<div class="ad-item-actions">' +
            '<button data-act="edit" data-i="' + i + '">Edit</button>' +
            '<button class="del" data-act="del" data-i="' + i + '">Delete</button>' +
          '</div>' +
        '</div>' +
        '<div class="ad-item-body">Every ' + (ad.freq || 10) + ' msgs · ' +
          escapeHtml((ad.desc || '').slice(0, 60)) + '</div>';
      item.querySelector('[data-act="edit"]').onclick = () => openAdEditor(i);
      item.querySelector('[data-act="del"]').onclick = () => deleteAd(i);
      list.appendChild(item);
    });
  }

  function openAdEditor(index = -1) {
    const isNew = index === -1;
    const ad = isNew ? {} : ads[index];
    $('adEditTitle').textContent = isNew ? '📢 NEW AD' : '✏️ EDIT AD';
    $('adTitle').value = ad.title || '';
    $('adDesc').value = ad.desc || '';
    $('adImage').value = ad.image || '';
    $('adLink').value = ad.link || '';
    $('adCta').value = ad.cta || 'Learn More';
    $('adFreq').value = ad.freq || 10;
    $('adEditModal').dataset.index = index;
    $('adEditModal').classList.add('show');
  }

  function saveAdFromEditor() {
    const index = parseInt($('adEditModal').dataset.index);
    const ad = {
      title: $('adTitle').value.trim() || 'Special Offer',
      desc: $('adDesc').value.trim(),
      image: $('adImage').value.trim(),
      link: $('adLink').value.trim(),
      cta: $('adCta').value.trim() || 'Learn More',
      freq: parseInt($('adFreq').value) || 10
    };
    if (index === -1) ads.push(ad);
    else ads[index] = ad;
    localStorage.setItem('dark-ads', JSON.stringify(ads));
    renderAdList();
    $('adEditModal').classList.remove('show');
    toast('Ad saved');
  }

  function deleteAd(index) {
    if (!confirm('Delete this ad?')) return;
    ads.splice(index, 1);
    localStorage.setItem('dark-ads', JSON.stringify(ads));
    renderAdList();
    toast('Ad deleted');
  }

  function checkAndShowAd() {
    if (ads.length === 0) return;
    const dueAd = ads.find(ad => messageCounter > 0 && messageCounter % (ad.freq || 10) === 0);
    if (!dueAd) return;
    showFullscreenAd(dueAd);
  }

  function showFullscreenAd(ad) {
    const overlay = $('adFullscreen');
    $('adFsTitle').textContent = ad.title || 'Sponsored';
    $('adFsDesc').textContent = ad.desc || '';
    const cta = $('adFsCta');
    cta.textContent = ad.cta || 'Learn More';
    cta.href = ad.link || '#';
    const img = $('adFsImage');
    if (ad.image) { img.src = ad.image; img.style.display = 'block'; }
    else img.style.display = 'none';
    overlay.classList.add('show');
    const skipBtn = $('adSkip');
    let countdown = 5;
    skipBtn.disabled = true;
    skipBtn.textContent = countdown;
    const timer = setInterval(() => {
      countdown--;
      skipBtn.textContent = countdown;
      if (countdown <= 0) {
        clearInterval(timer);
        skipBtn.disabled = false;
        skipBtn.textContent = '✕';
      }
    }, 1000);
  }

  function buildLangGrid() {
    const grid = $('langGrid');
    grid.innerHTML = '';
    LANGUAGES.forEach(l => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'lang-option' + (l.code === preferredLang ? ' active' : '');
      btn.innerHTML = '<span class="lang-flag">' + l.flag + '</span><span>' + l.native + '</span>';
      btn.onclick = () => {
        preferredLang = l.code;
        localStorage.setItem('dark-lang', preferredLang);
        buildLangGrid();
        toast('Language: ' + l.name);
      };
      grid.appendChild(btn);
    });
  }

  function buildImageQualityGrid() {
    const grid = $('imageQualityGrid');
    grid.innerHTML = '';
    IMAGE_QUALITY.forEach(q => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'model-opt' + (q.code === preferredQuality ? ' active' : '');
      btn.innerHTML = '<span class="m-name">' + q.name + '</span><span class="m-desc">' + q.desc + '</span>';
      btn.onclick = () => {
        preferredQuality = q.code;
        localStorage.setItem('dark-quality', preferredQuality);
        buildImageQualityGrid();
        toast('Image: ' + q.name);
      };
      grid.appendChild(btn);
    });
  }

  function buildSizeGrid() {
    const grid = $('sizeGrid');
    grid.innerHTML = '';
    IMAGE_SIZES.forEach(s => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'size-opt' + (s.code === preferredSize ? ' active' : '');
      btn.innerHTML = '<span>' + s.name + '</span><small>' + s.dim + '</small>';
      btn.onclick = () => {
        preferredSize = s.code;
        localStorage.setItem('dark-size', preferredSize);
        buildSizeGrid();
        toast('Size: ' + s.name);
      };
      grid.appendChild(btn);
    });
  }

  function openSettings() {
    $('systemPrompt').value = buildSystemPrompt();
    buildLangGrid();
    buildImageQualityGrid();
    buildSizeGrid();
    renderAuthBox();
    $('autoSpeakToggle').classList.toggle('on', autoSpeak);
    $('themeToggle').classList.toggle('on', theme === 'dark');
    $('settingsModal').classList.add('show');
  }

  function saveSettings() {
    const val = $('systemPrompt').value.trim();
    if (val) {
      localStorage.setItem('dark-prompt', val);
      Object.values(threads).forEach(t => {
        if (t.messages[0]?.role === 'system') t.messages[0].content = val;
      });
      saveThreads();
    }
    autoSpeak = $('autoSpeakToggle').classList.contains('on');
    localStorage.setItem('dark-autospeak', autoSpeak);
    theme = $('themeToggle').classList.contains('on') ? 'dark' : 'light';
    applyTheme();
    $('settingsModal').classList.remove('show');
    toast('Settings saved');
  }

  function handleSend(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    if (busy) {
      if (abortController) abortController.abort();
      return;
    }
    sendMsg();
  }
  $('sendBtn').addEventListener('click', handleSend, false);
  $('sendBtn').addEventListener('touchend', (e) => { e.preventDefault(); handleSend(e); }, { passive: false });

  $('chatInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (!busy) sendMsg(); }
  });

  $('btnImage').onclick = (e) => {
    e.preventDefault();
    if (busy) { toast('Wait'); return; }
    const p = $('chatInput').value.trim();
    if (!p) { toast('Type image description'); $('chatInput').focus(); return; }
    generateImage(p);
  };

  $('btnVideo').onclick = (e) => {
    e.preventDefault();
    if (busy) { toast('Wait'); return; }
    const p = $('chatInput').value.trim();
    if (!p) { toast('Type video description'); $('chatInput').focus(); return; }
    generateVideo(p);
  };

  $('micBtn').addEventListener('click', (e) => {
    e.preventDefault();
    if (voiceModeActive) stopVoiceMode();
    else startVoiceMode();
  }, false);
  $('micBtn').addEventListener('touchend', (e) => {
    e.preventDefault();
    if (voiceModeActive) stopVoiceMode();
    else startVoiceMode();
  }, { passive: false });

  $('recCancel').onclick = () => { stopVoiceMode(); toast('Voice mode off'); };
  $('recSend').onclick = () => {
    if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
  };

  $('btnClear').onclick = () => {
    if (!confirm('Clear this chat?')) return;
    const t = threads[activeId];
    t.messages = [{ role: 'system', content: buildSystemPrompt() }];
    t.title = 'New chat';
    saveThreads(); renderThreads(); rebuildUI();
    toast('Chat cleared');
  };

  $('btnSave').onclick = () => {
    const t = threads[activeId];
    const visible = t.messages.filter(m => m.role !== 'system');
    if (!visible.length) { toast('Nothing to save'); return; }
    const md = '# ' + t.title + '\n\n' +
      visible.map(m => '**' + (m.role === 'user' ? 'You' : 'DARK') + ':**\n\n' + m.content)
        .join('\n\n---\n\n');
    const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'dark-' + t.title.replace(/[^a-z0-9]/gi, '_').slice(0, 30) + '.md';
    a.click();
    $('btnSave').classList.add('pulse', 'done');
    setTimeout(() => {
      $('btnSave').classList.remove('pulse');
      setTimeout(() => $('btnSave').classList.remove('done'), 800);
    }, 600);
    toast('Saved');
  };

  $('btnSettings').onclick = openSettings;
  $('sidebarToggle').onclick = () => {
    if (window.innerWidth <= 900) $('sidebar').classList.toggle('open');
    else $('sidebar').classList.toggle('hidden');
  };
  $('newChat').onclick = () => createThread();
  $('searchBox').oninput = (e) => {
    searchQuery = e.target.value.trim().toLowerCase();
    renderThreads();
  };
  $('exportAllBtn').onclick = () => {
    const all = Object.values(threads).map(t => {
      const visible = t.messages.filter(m => m.role !== 'system');
      return '# ' + t.title + '\n\n' +
        visible.map(m => '**' + (m.role === 'user' ? 'You' : 'DARK') + ':**\n\n' + m.content).join('\n\n');
    }).join('\n\n---\n\n---\n\n');
    const blob = new Blob([all], { type: 'text/markdown;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'dark-all-chats.md';
    a.click();
    toast('Exported');
  };
  $('clearAllBtn').onclick = () => {
    if (!confirm('Delete ALL chats?')) return;
    threads = {}; activeId = null;
    createThread(true); saveThreads(); renderThreads(); rebuildUI();
    toast('All cleared');
  };
  $('userCard').onclick = () => { if (currentUser) openProfile(); };
  $('adminBtn').onclick = openAdmin;
  $('profileClose').onclick = () => $('profileModal').classList.remove('show');
  $('profileModal').onclick = (e) => {
    if (e.target === $('profileModal')) $('profileModal').classList.remove('show');
  };
  $('adminClose').onclick = () => $('adminModal').classList.remove('show');
  $('adminModal').onclick = (e) => {
    if (e.target === $('adminModal')) $('adminModal').classList.remove('show');
  };
  // Admin quick actions
const viewSiteBtn = $('viewSiteBtn');
if (viewSiteBtn) viewSiteBtn.onclick = viewSite;

const exportDataBtn = $('exportDataBtn');
if (exportDataBtn) exportDataBtn.onclick = exportAllData;

const importDataBtn = $('importDataBtn');
if (importDataBtn) importDataBtn.onclick = importData;

const resetStatsBtn = $('resetStatsBtn');
if (resetStatsBtn) resetStatsBtn.onclick = resetStats;$('addAdBtn').onclick = () => openAdEditor(-1);
  $('adEditCancel').onclick = () => $('adEditModal').classList.remove('show');
  $('adEditSave').onclick = saveAdFromEditor;
  $('adEditModal').onclick = (e) => {
    if (e.target === $('adEditModal')) $('adEditModal').classList.remove('show');
  };
  $('settingsCancel').onclick = () => $('settingsModal').classList.remove('show');
  $('settingsSave').onclick = saveSettings;
  $('settingsModal').onclick = (e) => {
    if (e.target === $('settingsModal')) $('settingsModal').classList.remove('show');
  };
  $('autoSpeakToggle').onclick = () => $('autoSpeakToggle').classList.toggle('on');
  $('themeToggle').onclick = () => $('themeToggle').classList.toggle('on');
  $('adSkip').onclick = () => {
    if ($('adSkip').disabled) return;
    $('adFullscreen').classList.remove('show');
  };
  $('authBadge').onclick = () => { if (currentUser) openProfile(); };

  async function init() {
    loadThreads();
    const totalUsers = parseInt(localStorage.getItem('dark-total-users') || '0');
    localStorage.setItem('dark-total-users', totalUsers + 1);

    try {
      await updateAuthUI();
    } catch (e) { console.warn('Auth init failed:', e); }

    renderThreads();
    rebuildUI();

    try {
      const h = await fetch(PROXY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [{ role: 'user', content: 'ping' }] })
      });
      setStatus(h.ok ? 'Online' : 'Error', h.ok);
    } catch (e) {
      setStatus('Proxy offline', false);
    }
  }

  init();

</script>
</body>
</html>
